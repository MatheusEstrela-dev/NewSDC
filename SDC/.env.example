# ============================================================================
# SDC - Exemplo de configuracao de ambiente
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# ============================================================================

APP_NAME=SDC
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sdc
DB_USERNAME=sdc
DB_PASSWORD=
DB_PERSISTENT=false

# Tamanho do pool de conexoes PDO por worker sob Swoole (App\Support\Database\SwoolePdoPool).
# Teto: SWOOLE_PG_POOL_SIZE * OCTANE_WORKERS * instancias <= max_connections do Postgres - reserva.
# Azure: 16. On-premise modesto: reduzir (ex.: 8).
SWOOLE_PG_POOL_SIZE=16
SWOOLE_PG_POOL_TIMEOUT=3.0

# Octane/Swoole: hooks seguem OFF por default. Ligue somente em canario/load-test
# depois de validar Redis/PDO coroutine-aware e mantendo rollback por env.
OCTANE_SERVER=swoole
OCTANE_HOOK_FLAGS_ENABLED=false
OCTANE_TASK_WORKERS=4
OCTANE_TASK_WAIT_MS=5000
OCTANE_REDIS_POOL_SIZE=16
OCTANE_REDIS_POOL_TIMEOUT=3.0

# ── Database AI (PostgreSQL - Citus/pgvector) ─────────────────────────────
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=sdc_ai
DB_PGSQL_USERNAME=sdc
DB_PGSQL_PASSWORD=

# ── Cache / Session (Redis) ────────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=sdc@defesacivil.mg.gov.br
MAIL_FROM_NAME="${APP_NAME}"

# ── AI / Gemini ────────────────────────────────────────────────────────────
AI_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS=4096

# ── Telegram Bot (integracoes pessoais por usuario) ─────────────
# Bot global do SDC criado via @BotFather. Cada user faz pairing pelo /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# String random qualquer; vai no PATH do webhook URL para autenticacao.
# Setup: curl https://api.telegram.org/bot{TOKEN}/setWebhook?url={APP_URL}/api/integrations/telegram/webhook/{SECRET}
TELEGRAM_WEBHOOK_SECRET=

# ── Resilience knobs (DB pool, circuit breaker, rate limit, backpressure) ─────────────
# Limite de requests concorrentes que tocam o DB (semáforo Redis)
DB_MAX_CONCURRENT=100
# Limite separado para jobs de webhook
DB_MAX_CONCURRENT_WEBHOOK=20
# Espera máxima por slot livre (ms) — acima disso, request recebe 503
DB_ACQUIRE_WAIT_MS=2000
# Intervalo de polling entre tentativas de acquire (ms)
DB_ACQUIRE_POLL_MS=50

# Circuit breaker: p95 de query (ms) que sinaliza degradação
DB_CB_P95_MS=500
# Quantos timeouts na janela disparam abertura do circuito
DB_CB_TIMEOUT_COUNT=5
# Janela de observação (segundos)
DB_CB_WINDOW_S=60
# Após abrir, tempo (segundos) até tentar half-open
DB_CB_RESET_S=30

# Bucket global de rate limit (requests por segundo, global)
RATE_LIMIT_GLOBAL=1500
# Se Redis falhar: true=derruba tiers baixos (recomendado), false=permite tudo
RATE_LIMIT_FAIL_CLOSED=true

# Query budget: acima desse número de queries por request, loga warning (suspeita N+1)
QUERY_BUDGET_WARN=30
# Acima desse número, loga critical
QUERY_BUDGET_FAIL=100

# Backpressure: fração de utilização do semáforo (0.0–1.0) que dropa tier
BP_PUBLIC_DROP=0.7
BP_FREE_DROP=0.9

# ============================================================
# Anexos por modulo (bind mount na VM on-prem)
# ============================================================
# Raiz do bind mount de anexos DENTRO do container (o compose monta
# /mnt/newsdc_storage -> /data/anexos). Quando definido, os disks de modulo
# (pae/rat/compdec/tdap/exports) apontam para ANEXOS_ROOT/{MODULO} em vez de
# storage/app. Sem esta env (dev puro) ou com AZURE_STORAGE_CONNECTION_STRING
# (App Service) o comportamento anterior e mantido.
# ANEXOS_ROOT=/data/anexos

# ============================================================================
# Ajuda Humanitaria (MAH)
# ============================================================================
# Base legada do sistema procedural (gestaocedec), acessada SOMENTE EM LEITURA
# para consultar saldo de material por deposito. Sem estas chaves o modulo
# reporta saldo indisponivel e continua operando normalmente.
DB_LEGACY_HOST=127.0.0.1
DB_LEGACY_PORT=3306
DB_LEGACY_DATABASE=gestaocedec_local
DB_LEGACY_USERNAME=
DB_LEGACY_PASSWORD=

AJUDA_HUMANITARIA_DISK=local
AJUDA_HUMANITARIA_LEGACY_CONNECTION=legacy
AJUDA_HUMANITARIA_SALDO_CACHE_TTL=300

# ============================================================================
# Modulo Cisterna - leitura do legado sdc (ETL)
# ============================================================================
LEGADO_CISTERNA_DB_HOST=127.0.0.1
LEGADO_CISTERNA_DB_PORT=3306
LEGADO_CISTERNA_DB_DATABASE=dbsdc
LEGADO_CISTERNA_DB_USERNAME=root
LEGADO_CISTERNA_DB_PASSWORD=
LEGADO_CISTERNA_ANEXOS_ROOT=
