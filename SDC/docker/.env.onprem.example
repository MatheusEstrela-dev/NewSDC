# ============================================================================
# SDC on-premise (VM 8c/16GB) - copie para .env.onprem e preencha os segredos.
# NUNCA commitar o .env.onprem preenchido.
# Uso: copiar para /opt/sdc/.env.onprem na VM; consumido pelas stacks Swarm
# (jenkins/stack.data.onpremise.yml e jenkins/stack.app.onpremise.yml) e pelo
# stage de Migrations do pipeline (docker run --env-file)
# ============================================================================

APP_NAME="SDC - Sistema de Defesa Civil"
APP_URL=https://sdc.exemplo.mg.gov.br
# php artisan key:generate --show
APP_KEY=

VERSION=latest

DB_DATABASE=sdc
DB_USERNAME=sdc
DB_PASSWORD=

REDIS_PASSWORD=
REDIS_PREFIX=sdc_onprem_
CACHE_PREFIX=sdc_onprem_cache_

# Reverb (WebSocket) - gere valores aleatorios (ex.: openssl rand -hex 16)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Token do endpoint de metricas GET /api/health/metrics (openssl rand -hex 32)
METRICS_TOKEN=

# SMTP Prodemge (servidor interno, alcancavel direto da VM sem proxy).
# host/port/encryption/from tem default no stack.onprem.yml; as credenciais
# NAO tem default e sao obrigatorias aqui, senao o Postfix recusa o envio.
MAIL_MAILER=smtp
MAIL_HOST=smtpprdm.prodemge.gov.br
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=sdc@defesacivil.mg.gov.br
MAIL_FROM_NAME="SDC - Sistema de Defesa Civil"

LOG_LEVEL=info
