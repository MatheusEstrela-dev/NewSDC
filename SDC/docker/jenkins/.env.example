# ===== JENKINS ON-PREMISE - VARIAVEIS DE AMBIENTE =====
# Copie para .env e preencha. Nada de segredo commitado.
# Uso: cd docker/jenkins && docker compose -f docker-compose.jenkins.yml --env-file .env up -d --build

# ===== JENKINS ADMIN =====
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_ADMIN_EMAIL=admin@sdc.local
JENKINS_OMLIOES_PASSWORD=
JENKINS_MATHEUS_PASSWORD=

# ===== JENKINS URL (como os usuarios acessam) =====
JENKINS_URL=http://10.160.131.50:8080

# ===== PROXY PRODEMGE (saida para internet autentica por IP) =====
HTTP_PROXY=http://proxy.prodemge.gov.br:8080
HTTPS_PROXY=http://proxy.prodemge.gov.br:8080
NO_PROXY=localhost,127.0.0.1,docker-proxy,registry,jenkins,10.160.131.50,10.0.0.0/8,.prodemge.gov.br,.mg.gov.br
JENKINS_PROXY_HOST=proxy.prodemge.gov.br
JENKINS_PROXY_PORT=8080

# ===== DOCKER =====
# GID do grupo docker no host (obter com: getent group docker | cut -d: -f3)
DOCKER_GID=999

# ===== REGISTRY PRIVADO LOCAL =====
# 127.0.0.1:5000 sem auth (loopback). Preencher apenas quando houver TLS+htpasswd.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ===== GIT =====
GIT_REPO_URL=https://github.com/MatheusEstrela-dev/NewSDC.git
GIT_DEPLOY_BRANCH=*/main
GITHUB_USERNAME=MatheusEstrela-dev
GITHUB_TOKEN=
# Para SSH: cole a chave privada completa (escape newlines com \n)
GIT_SSH_PRIVATE_KEY=

# ===== PIPELINE (SDC/Jenkinsfile.onprem) =====
# Health check pos-deploy via Caddy publicado na VM
APP_HEALTH_URL=https://10.160.131.50/health

# ===== JENKINS AGENT =====
# Secret gerado apos primeira inicializacao do Jenkins (node docker-agent)
JENKINS_AGENT_SECRET=

# ===== BACKUP =====
BACKUP_REMOTE_TYPE=rsync
RSYNC_HOST=
RSYNC_USER=
RSYNC_PATH=/backups/jenkins
# S3 somente se houver egress liberado
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sdc-jenkins-backups
S3_REGION=us-east-1

# ===== MONITORAMENTO =====
JENKINS_PROMETHEUS_USER=admin
JENKINS_PROMETHEUS_PASSWORD=
PROMETHEUS_PUSHGATEWAY=

# ===== NOTIFICACOES =====
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
