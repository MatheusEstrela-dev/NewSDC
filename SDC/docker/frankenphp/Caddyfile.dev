{
	admin localhost:2019
	auto_https disable_redirects

	frankenphp {
		php_ini post_max_size 64M
		php_ini upload_max_filesize 64M

		worker {
			file {$APP_PUBLIC_PATH}/frankenphp-worker.php
			num {$FRANKENPHP_WORKERS:auto}
		}
	}
}

# HTTP -> HTTPS redirect (porta 80 -> porta 18443 no host)
http://:80 {
	redir https://localhost:18443{uri} permanent
}

# HTTPS principal com certificado self-signed
https://localhost {
	tls internal

	log {
		level WARN
	}

	request_body {
		max_size 64MB
	}

	route {
		root * {$APP_PUBLIC_PATH}

		# Compressao agressiva
		encode {
			zstd
			br
			gzip
			minimum_length 256
		}

		# Cache longo para assets estaticos (1 ano)
		@static {
			path *.js *.css *.woff *.woff2 *.ttf *.ico *.png *.jpg *.jpeg *.webp *.svg *.avif
		}
		header @static Cache-Control "public, max-age=31536000, immutable"

		# Cache para build assets
		@build {
			path /build/*
		}
		header @build Cache-Control "public, max-age=31536000, immutable"

		# No cache para HTML/API
		@dynamic {
			not path /build/* *.js *.css *.woff* *.png *.jpg *.ico *.svg
		}
		header @dynamic Cache-Control "no-cache, private"

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
