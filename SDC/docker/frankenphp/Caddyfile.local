{
	admin localhost:2019
	auto_https disable_redirects

	frankenphp {
		worker {
			file /app/public/frankenphp-worker.php
			num {$FRANKENPHP_WORKERS:4}
		}
	}
}

https://localhost {
	bind 0.0.0.0

	tls internal

	log {
		level WARN
	}

	route {
		root * /app/public

		encode {
			zstd
			br
			gzip
			minimum_length 256
		}

		@static {
			path *.js *.css *.woff *.woff2 *.ttf *.ico *.png *.jpg *.jpeg *.webp *.svg *.avif
		}
		header @static Cache-Control "public, max-age=31536000, immutable"

		@build {
			path /build/*
		}
		header @build Cache-Control "public, max-age=31536000, immutable"

		@dynamic {
			not path /build/* *.js *.css *.woff* *.png *.jpg *.ico *.svg
		}
		header @dynamic Cache-Control "no-cache, private"

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}

http://:80 {
	bind 0.0.0.0
	redir https://{host}:443{uri} permanent
}
