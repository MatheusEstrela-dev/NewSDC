# ============================================================================
# SDC - Bun / Vite DOCKERFILE (Desenvolvimento)
# Migrado de Node.js 20 para Bun para performance de install/build
# ============================================================================

FROM oven/bun:1-alpine

WORKDIR /var/www

# Bun precisa de bash e wget para scripts e healthcheck
RUN apk add --no-cache bash wget

# Copiar arquivos de dependencias primeiro (melhor cache de camadas)
COPY package.json bun.lock* package-lock.json* ./

# O codigo fonte sera montado via volume no runtime
# node_modules sera populado via bun install no primeiro start
