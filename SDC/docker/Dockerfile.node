# ============================================================================
# SDC - Node.js / Vite DOCKERFILE (Desenvolvimento)
# Instala dependencias durante o build (usa rede do Docker com internet)
# Resolve conflito de binarios nativos Windows/Linux (rollup-linux-x64-musl)
# ============================================================================

FROM node:20-alpine

WORKDIR /var/www

# Copiar arquivos de dependencias primeiro (melhor cache de camadas)
COPY package.json package-lock.json* ./

# Instalar dependencias durante o build
# O build do Docker usa a rede padrao (bridge com NAT), que tem acesso a internet
# Isso garante binarios nativos corretos para Linux Alpine (musl)
RUN npm install

# O codigo fonte sera montado via volume no runtime
# node_modules sera copiado para o volume nomeado na primeira execucao
