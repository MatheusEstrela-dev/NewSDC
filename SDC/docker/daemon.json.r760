{
  "comment": "Docker daemon do R760 - copie para /etc/docker/daemon.json no servidor e reinicie: systemctl restart docker. Ajuste data-root para o ponto de montagem do array NVMe (PLP).",

  "data-root": "/mnt/nvme-raid/docker",

  "storage-driver": "overlay2",

  "log-driver": "json-file",
  "log-opts": {
    "max-size": "50m",
    "max-file": "5"
  },

  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Hard": 65536,
      "Soft": 65536
    }
  },

  "live-restore": true,
  "userland-proxy": false,
  "no-new-privileges": true
}
