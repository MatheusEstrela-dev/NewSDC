# ============================================================================
# Caddy - edge do SDC (R760). TLS automatico (Let's Encrypt) + proxy reverso.
# Troque {$APP_DOMAIN} pelo dominio real via .env.prod (ex.: sdc.defesacivil.mg.gov.br).
# Para certificado interno/corporativo, substitua o bloco por `tls /caminho/cert /caminho/key`.
# ============================================================================

{$APP_DOMAIN} {
	# Segmento .ts ja e video comprimido: gzip/zstd gasta CPU sem ganho. O
	# mailcap do Alpine ainda tipa .ts como text/vnd.trolltech.linguist (text/*
	# entra na compressao por padrao), por isso a exclusao e explicita.
	# A playlist .m3u8 segue comprimivel.
	@comprimivel not path *.ts
	encode @comprimivel zstd gzip

	# Reverb (websocket) atras do Caddy, sem porta extra publicada no host.
	# Reverb nao usa prefixo de path (REVERB_SERVER_PATH vazio), entao o
	# handshake do cliente (laravel-echo/pusher-js) cai em /app/{key}.
	@reverb path /app/*
	reverse_proxy @reverb reverb:8080

	# Videos do EAD: o Caddy entrega do volume, o Octane so autoriza (204/403).
	handle_path /videos/* {
		# route fixa a ordem: o Cache-Control so existe depois da autorizacao
		# (sem route o header rodaria antes e o 403 sairia cacheavel).
		route {
			forward_auth app:8000 {
				uri /videos/auth
				header_up X-Forwarded-Uri {http.request.orig_uri}
			}
			root * {$VIDEOS_HLS_ROOT:/srv/storage/treinamentos/hls}
			# Segmento nunca muda dentro de uma versao: cache longo no navegador.
			# Playlist fica em 1h para a autorizacao valer a cada nova reproducao.
			# "file" restringe o header a arquivo existente (404 nao e cacheado).
			@segmento {
				path *.ts
				file
			}
			@playlist {
				path *.m3u8
				file
			}
			header @segmento Cache-Control "private, max-age=31536000, immutable"
			header @playlist Cache-Control "private, max-age=3600"
			# Content-Type explicito: o mime.types do Alpine tipa .ts como
			# text/vnd.trolltech.linguist. O file_server so tipa se nao houver header.
			header @segmento Content-Type "video/mp2t"
			header @playlist Content-Type "application/vnd.apple.mpegurl"
			file_server {
				hide .tmp-*
			}
		}
	}

	# Octane escuta na 8000 dentro da rede sdc_edge.
	reverse_proxy app:8000 {
		health_uri /health
		health_interval 15s
		header_up X-Forwarded-Proto https
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
