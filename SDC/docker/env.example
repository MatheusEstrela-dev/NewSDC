# ============================================================================
# SDC - Variáveis de Ambiente Docker
# Copie para .env no diretório raiz e ajuste os valores
# ============================================================================

# ==========================================
# Host Configuration (para mapeamento de UID/GID)
# ==========================================
HOST_UID=1000
HOST_GID=1000

# ==========================================
# Application
# ==========================================
APP_NAME="SDC - Sistema de Defesa Civil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOMAIN=localhost

# ==========================================
# Database (PostgreSQL 17)
# ==========================================
# Dev local: container db_ai (Citus 12.1 + pgvector 0.8 + PostGIS, sslmode=disable).
# Producao: Azure Flexible Server PG17 (<srv>.postgres.database.azure.com,
#           sslmode=verify-full, DB_SSL_CA aponta para DigiCert Global Root G2).
DB_CONNECTION=pgsql
DB_HOST=db_ai
DB_PORT=5432
DB_DATABASE=sdc
DB_USERNAME=sdc
DB_PASSWORD=secret
DB_SSLMODE=disable
DB_SSL_CA=
DB_SEARCH_PATH=public

# Conexao secundaria para workload de IA (embeddings/RAG). Em dev aponta para
# o mesmo db_ai; em prod pode apontar para outra database/schema no mesmo Azure.
DB_PGSQL_HOST=db_ai
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=sdc_ai
DB_PGSQL_USERNAME=sdc
DB_PGSQL_PASSWORD=secret

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ==========================================
# Cache / Session / Queue
# ==========================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

# ==========================================
# Mail (Desenvolvimento - Mailhog)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sdc.mg.gov.br"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==========================================
# Octane (RoadRunner)
# ==========================================
OCTANE_SERVER=roadrunner
RR_NUM_WORKERS=auto

# ==========================================
# Produção (adicionar quando for deploy)
# ==========================================
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:YOUR_KEY_HERE

# ACME_EMAIL=admin@seudominio.com
# TRAEFIK_USERS=admin:$$apr1$$...

# GRAFANA_USER=admin
# GRAFANA_PASSWORD=secure_password

# AWS S3 (Backup)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
# BACKUP_S3_BUCKET=sdc-backups

# ==========================================
# Build Info (CI/CD)
# ==========================================
VERSION=1.0.0
BUILD_DATE=
VCS_REF=

