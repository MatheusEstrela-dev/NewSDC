{
  "dashboard": {
    "id": null,
    "uid": "golden-signals",
    "title": "SDC - Golden Signals Overview",
    "tags": ["prometheus", "golden-signals"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "graph",
        "title": "LATENCIA - Probes HTTP",
        "targets": [
          {
            "expr": "probe_duration_seconds{probe_type=~\"http|health_check\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "Tempo" },
          { "format": "short" }
        ]
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "graph",
        "title": "DISPONIBILIDADE - Probe Success",
        "targets": [
          {
            "expr": "probe_success{probe_type=~\"http|health_check\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "0/1", "max": 1, "min": 0 },
          { "format": "short" }
        ]
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "type": "graph",
        "title": "HTTP - Status Code",
        "targets": [
          {
            "expr": "probe_http_status_code{probe_type=~\"http|health_check\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Status" },
          { "format": "short" }
        ]
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "type": "graph",
        "title": "SATURACAO - Recursos do Sistema",
        "targets": [
          {
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU %"
          },
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "Memoria %"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "Uso", "max": 100 },
          { "format": "short" }
        ]
      }
    ]
  }
}
