# ============================================================================
# SDC - DOCKERFILE SWOOLE (APENAS LOAD-TEST LOCAL)
# Runtime-only: instala PHP + extensoes (incl. swoole), SEM composer/bun/COPY.
# O codigo (vendor + assets buildados) entra por volume-mount em /var/www,
# igual ao fluxo de dev. NAO use em producao: a imagem de prod e o
# docker/swoole/Dockerfile (que faz composer install + bun build + COPY).
# Objetivo: validar o Swoole rodando contra o DB/Redis de dev e load-testar.
# ============================================================================

FROM php:8.4-cli-alpine

RUN apk add --no-cache \
    bash curl git \
    libpng libjpeg-turbo freetype libwebp oniguruma libxml2 libzip \
    postgresql-libs icu-libs jemalloc openssl \
    && apk add --no-cache --virtual .build-deps \
    libpng-dev libjpeg-turbo-dev freetype-dev libwebp-dev oniguruma-dev \
    libxml2-dev libzip-dev postgresql-dev icu-dev openssl-dev linux-headers \
    $PHPIZE_DEPS

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
    pdo_mysql pdo_pgsql mysqli mbstring exif pcntl bcmath gd zip intl opcache sockets

# Mesma combinacao validada na Fase 0: swoole com openssl, sem brotli.
RUN pecl install igbinary \
    && docker-php-ext-enable igbinary \
    && pecl install redis-6.0.2 \
    && docker-php-ext-enable redis \
    && pecl install --configureoptions 'enable-openssl="yes" enable-sockets="yes" enable-brotli="no"' swoole \
    && docker-php-ext-enable swoole \
    && apk del .build-deps

ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

WORKDIR /var/www

EXPOSE 8000

# Codigo vem por volume-mount; comando definido no `docker run`.
CMD ["php", "artisan", "octane:start", "--server=swoole", "--host=0.0.0.0", "--port=8000", "--workers=4", "--task-workers=2"]
