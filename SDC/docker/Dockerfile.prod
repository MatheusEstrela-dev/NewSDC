# ============================================================================
# SDC - PRODUCTION DOCKERFILE
# Build otimizado para Azure App Service
# ============================================================================

FROM php:8.3-cli-alpine

LABEL maintainer="SDC Team"
LABEL environment="production"

# Instalar dependências
RUN apk add --no-cache \
    bash \
    curl \
    git \
    libpng \
    libjpeg-turbo \
    freetype \
    libwebp \
    oniguruma \
    libxml2 \
    libzip \
    postgresql-libs \
    icu-libs \
    && apk add --no-cache --virtual .build-deps \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libwebp-dev \
    oniguruma-dev \
    libxml2-dev \
    libzip-dev \
    postgresql-dev \
    icu-dev \
    linux-headers \
    $PHPIZE_DEPS

# Instalar extensoes PHP
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    --with-webp \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    pdo_pgsql \
    mysqli \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    intl \
    opcache \
    sockets \
    && pecl install redis-6.0.2 \
    && docker-php-ext-enable redis \
    && apk del .build-deps


# Copiar Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Instalar Bun para compilar assets (temporario - sera removido apos build)
RUN apk add --no-cache curl bash unzip \
    && curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# Configuração PHP
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && echo "memory_limit=512M" > /usr/local/etc/php/conf.d/99-memory.ini

# Diretório de trabalho
WORKDIR /var/www

# Copiar arquivos de dependências primeiro (para cache do Docker)
COPY composer.json composer.lock* ./
COPY package.json bun.lock* ./

# Verificar se composer.json existe
RUN test -f composer.json || (echo "ERRO: composer.json não encontrado!" && ls -la && exit 1)

# Instalar dependências PHP (antes de copiar todo o código - melhor cache)
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --ignore-platform-reqs \
    --no-scripts || (echo "ERRO ao instalar dependências" && cat composer.json && exit 1)

# Copiar resto do código da aplicação
COPY . .

# Remover arquivo hot do Vite dev server
RUN rm -f public/hot

# Garantir que bootstrap/cache exista antes do dump-autoload
# (o post-autoload-dump roda artisan package:discover, que escreve o manifest
#  em bootstrap/cache; em contexto limpo o diretorio ainda nao existe)
RUN mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs

# Executar scripts do composer após copiar código
RUN composer dump-autoload --optimize --classmap-authoritative

# Gate de build: toda classe type-hintada nas rotas (ex.: FormRequest) deve
# resolver pelo autoloader, senao o BUILD falha. Evita publicar imagem com
# classmap inconsistente com o codigo -> 500 em toda pagina via Ziggy (10/06).
# APP_KEY dummy inline so para bootar o artisan -- route:verify-signatures nao
# toca em DB/rede; o entrypoint injeta o ambiente real em runtime. (.env e
# .dockerignored, entao nao existe no contexto de build.)
RUN APP_ENV=production APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    php artisan route:verify-signatures

# Instalar dependencias e compilar assets com Bun
RUN bun install --frozen-lockfile && \
    bun run build && \
    ls -la public/build/ && \
    test -f public/build/manifest.json || exit 1

# Remover Bun apos compilar assets (reduzir tamanho da imagem)
RUN rm -rf /root/.bun /usr/local/bin/bun /usr/local/bin/bunx

# Criar diretórios
RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Copiar script de entrypoint (agora que o código foi copiado)
RUN cp /var/www/docker/scripts/entrypoint.prod.sh /start.sh \
    && chmod +x /start.sh

# Verificar que tudo está no lugar
RUN ls -la /var/www && \
    test -f /var/www/composer.json && \
    test -d /var/www/vendor && \
    echo "✅ Build verificado: composer.json e vendor presentes"

# Expor porta
EXPOSE 8000

# Start
CMD ["/start.sh"]
