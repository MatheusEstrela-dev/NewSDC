FROM php:8.3-fpm-alpine

# Argumentos de build
ARG UID=1000
ARG GID=1000

# Instalar dependências do sistema
RUN apk add --no-cache \
    bash \
    git \
    curl \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    supervisor \
    mysql-client \
    postgresql-client \
    postgresql-dev

# Instalar extensões PHP
RUN docker-php-ext-install \
    pdo_mysql \
    pdo_pgsql \
    zip \
    gd \
    pcntl \
    bcmath

# Instalar Redis extension
RUN apk add --no-cache pcre-dev $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del pcre-dev $PHPIZE_DEPS

# Configurar usuário www-data
RUN delgroup www-data 2>/dev/null || true \
    && deluser www-data 2>/dev/null || true \
    && addgroup -g ${GID} www-data \
    && adduser -D -u ${UID} -G www-data www-data

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar working directory
WORKDIR /var/www

# Copiar código da aplicação
COPY --chown=www-data:www-data . /var/www

# Copiar configuração do Supervisor
COPY docker/supervisor/supervisord.conf /etc/supervisord.conf
COPY docker/supervisor/laravel-worker.conf /etc/supervisor/conf.d/laravel-worker.conf

# Criar diretórios necessários
RUN mkdir -p /var/www/storage/logs /var/log/supervisor \
    && chown -R www-data:www-data /var/www/storage /var/log/supervisor \
    && chmod -R 775 /var/www/storage /var/log/supervisor

# Comando de inicialização
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
