FROM php:8.4-cli-alpine

# Argumentos de build
ARG UID=1000
ARG GID=1000

# O pecl/PEAR ignora as variaveis de ambiente de proxy; atras do proxy
# corporativo o pecl install redis falha com "No releases available" sem isso.
# O "|| true" no pecl: config-set no canal pecl.php.net retorna erro espurio
# ("failed, channel pecl.php.net") mesmo com o proxy valendo — o pecl le a
# config do pear, que e a que importa.
RUN if [ -n "$http_proxy" ]; then pear config-set http_proxy "$http_proxy" && { pecl config-set http_proxy "$http_proxy" || true; }; fi

# Instalar dependencias do sistema e extensoes PHP usadas pelos jobs Laravel.
RUN apk add --no-cache \
    bash \
    git \
    curl \
    libpng \
    libjpeg-turbo \
    freetype \
    libwebp \
    oniguruma \
    libxml2 \
    libzip \
    postgresql-libs \
    icu-libs \
    mysql-client \
    postgresql-client \
    supervisor \
    && apk add --no-cache --virtual .build-deps \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libwebp-dev \
    oniguruma-dev \
    libxml2-dev \
    libzip-dev \
    postgresql-dev \
    icu-dev \
    linux-headers \
    $PHPIZE_DEPS \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        pdo_pgsql \
        mysqli \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache \
        sockets \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Configurar working directory
WORKDIR /var/www

# Copiar codigo da aplicacao
COPY --chown=www-data:www-data . /var/www

# Dependencias PHP (faltava nesta imagem: sem isto o worker crasha em loop
# com "Failed opening required vendor/autoload.php" - 20/07).
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --ignore-platform-reqs \
    --no-scripts || (echo "ERRO ao instalar dependencias" && cat composer.json && exit 1)

# Copiar configuracao do Supervisor
COPY docker/supervisor/supervisord.conf /etc/supervisord.conf
COPY docker/supervisor/laravel-worker.conf /etc/supervisor/conf.d/laravel-worker.conf
# Worker dedicado do pipeline medalhao (fila propria, timeout maior).
COPY docker/supervisor/medalhao-worker.conf /etc/supervisor/conf.d/medalhao-worker.conf

# Entrypoint com a guarda de mount de anexos (mesma do app)
COPY docker/queue/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Criar diretorios necessarios
RUN mkdir -p /var/www/storage/logs /var/log/supervisor \
    && chown -R www-data:www-data /var/www/storage /var/log/supervisor \
    && chmod -R 775 /var/www/storage /var/log/supervisor

# Comando de inicializacao (o entrypoint valida o mount de anexos antes)
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
