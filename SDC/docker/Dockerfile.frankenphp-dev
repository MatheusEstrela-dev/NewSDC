# ============================================================================
# SDC - Dockerfile FrankenPHP (Desenvolvimento Local)
# Variante dev do SDC/docker/frankenphp/Dockerfile:
#   - composer install COM dev deps
#   - OPcache com validate_timestamps (hot reload de PHP)
#   - Sem bun/build de assets (Vite roda no host)
# Build context: raiz do repo (NewSDC/), via SDC/docker/compose.dev.yml
# ============================================================================

FROM dunglas/frankenphp:1-php8.4-alpine

LABEL maintainer="SDC Team"
LABEL environment="development"
LABEL server="frankenphp"

# Extensoes PHP (mesma lista da imagem de prod)
RUN install-php-extensions \
    pdo_mysql \
    pdo_pgsql \
    mysqli \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    intl \
    opcache \
    sockets \
    redis

# Composer + utilitarios (curl, bash, unzip ja sao uteis no shell dev)
RUN apk add --no-cache composer curl bash unzip

# Config PHP dev: OPcache liga, MAS revalida timestamps (hot reload de codigo)
RUN echo "memory_limit=512M" > /usr/local/etc/php/conf.d/99-memory.ini \
    && echo "max_execution_time=120" >> /usr/local/etc/php/conf.d/99-memory.ini \
    && echo "upload_max_filesize=64M" >> /usr/local/etc/php/conf.d/99-memory.ini \
    && echo "post_max_size=64M" >> /usr/local/etc/php/conf.d/99-memory.ini \
    && echo "opcache.enable=1" > /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.interned_strings_buffer=32" >> /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.validate_timestamps=1" >> /usr/local/etc/php/conf.d/99-opcache.ini \
    && echo "opcache.revalidate_freq=0" >> /usr/local/etc/php/conf.d/99-opcache.ini

RUN test -f /usr/local/bin/frankenphp && chmod +x /usr/local/bin/frankenphp

WORKDIR /app

# Copiar deps (cache Docker). Build context = NewSDC/ (raiz), por isso o prefix SDC/.
COPY SDC/composer.json SDC/composer.lock* ./

# composer install COM dev deps. --ignore-platform-reqs evita falhar em libs que
# pedem ext-* fora da lista; --no-scripts evita rodar artisan antes do .env.
RUN composer install \
    --no-interaction \
    --prefer-dist \
    --no-autoloader \
    --ignore-platform-reqs \
    --no-scripts

# Copiar codigo da app (so o subdir SDC/). compose.dev.yml depois faz bind-mount
# de app/, config/, etc. por cima desse layer pra dar hot reload.
COPY SDC/ ./

# Remover hot file do Vite caso tenha sido commitado
RUN rm -f public/hot

# Autoloader otimizado (sem --no-dev — queremos as classes dev)
RUN composer dump-autoload --optimize --no-scripts

# Diretorios Laravel
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views \
             storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Entrypoint do FrankenPHP (mesma logica do prod; detecta APP_ENV=local)
# Compose monta read-only em /start.sh, mas baked aqui pra fallback.
COPY SDC/docker/frankenphp/scripts/entrypoint.sh /start.sh
RUN sed -i 's/\r$//' /start.sh && chmod +x /start.sh

EXPOSE 80 443 2019

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sfk https://localhost:${PORT:-443}/health || exit 1

CMD ["/start.sh"]
