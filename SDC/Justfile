# ============================================================================
# SDC - JUSTFILE ORQUESTRADOR
# Cross-Platform: Windows / Linux / macOS
# ============================================================================
# Uso: just <comando> ou just --list
# ----------------------------------------------------------------------------
# TRES AMBIENTES, TRES ALVOS:
#   dev        -> docker/compose.dev.yml   (containers newsdc_dev_*)  [PADRAO]
#   producao   -> Swarm via docker/jenkins/stack.*.onpremise.yml (VM)
#   monitor    -> docker/docker-compose.yml (stack local LEGADA; so monitoring)
# ============================================================================

# Windows: caminho explicito do Git Bash (o "bash" do PATH e o do WSL)
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-uc"]
set shell := ["bash", "-uc"]

export DOCKER_BUILDKIT := "1"
export COMPOSE_DOCKER_CLI_BUILD := "1"

# ============================================================================
# CORES ANSI
# ============================================================================
GREEN  := '\033[32m'
YELLOW := '\033[33m'
BLUE   := '\033[34m'
RED    := '\033[31m'
CYAN   := '\033[36m'
WHITE  := '\033[37m'
BOLD   := '\033[1m'
RESET  := '\033[0m'

# Variáveis
# Stack de DESENVOLVIMENTO (a unica que sobe localmente e na VM dev)
compose := "docker compose -f docker/compose.dev.yml"
# .env.prod na raiz do SDC e o env GLOBAL (app + CI); nunca commitado
compose_jenkins := "docker compose -f docker/jenkins/docker-compose.jenkins.yml --env-file .env.prod"
# Stack local LEGADA (mysql/nginx/node/db_ai): usada APENAS pelas receitas
# monitor-* ate o monitoramento migrar. NAO usar para app/db.
compose_legacy := "docker compose -f docker/docker-compose.yml"
app := compose + " exec app"
db := compose + " exec db"

# Receita padrão
[group('00 📚 AJUDA')]
@default: help

