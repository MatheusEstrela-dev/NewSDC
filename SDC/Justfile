# 🏥 Healthcheck de todos serviços
@health:
    printf "{{BOLD}}{{CYAN}}Verificando saúde dos serviços...{{RESET}}\n"
    echo ""
    printf "{{YELLOW}}App:         {{RESET}}"
    curl -sf http://localhost:18001 > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Nginx:       {{RESET}}"
    curl -sf http://localhost:18082 > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Vite:        {{RESET}}"
    curl -sf http://localhost:15175 > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Grafana:     {{RESET}}"
    curl -sf http://localhost:13000/api/health > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Prometheus:  {{RESET}}"
    curl -sf http://localhost:19090/-/healthy > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"

