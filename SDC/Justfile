    printf "  {{CYAN}}%-18s{{RESET}} %s\n" "monitor-logs" "Logs do monitoramento"
    printf "  {{CYAN}}%-18s{{RESET}} %s\n" "monitor-restart" "Reinicia monitoramento"
    echo ""
    printf "{{BOLD}}🐚 ACESSO & DEBUG:{{RESET}}\n"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell" "Shell app (www-data)"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell-root" "Shell app (root)"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell-db" "MySQL CLI"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell-redis" "Redis CLI"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell-queue" "Shell queue worker"
    printf "  {{WHITE}}%-18s{{RESET}} %s\n" "shell-node" "Shell node container"
    echo ""
    printf "{{BOLD}}🗑️ LIMPEZA:{{RESET}}\n"
    printf "  {{RED}}%-18s{{RESET}} %s\n" "clean" "Para containers (preserva volumes)"
    printf "  {{RED}}%-18s{{RESET}} %s\n" "clean-volumes" "Remove containers E volumes (APAGA DADOS!)"
    printf "  {{RED}}%-18s{{RESET}} %s\n" "clean-images" "Remove containers, volumes E imagens"
    printf "  {{RED}}%-18s{{RESET}} %s\n" "clean-system" "Limpeza completa do Docker system"
    printf "  {{RED}}%-18s{{RESET}} %s\n" "nuke" "DESTRUIÇÃO TOTAL"
