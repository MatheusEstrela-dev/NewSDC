    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "cache-clear" "Limpa caches Laravel"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "cache-optimize" "Reconstroi caches (config/route/view/event)"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "test" "PHPUnit"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "test-filter F" "PHPUnit filtrado"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "test-e2e" "Playwright E2E (dotenvx vault)"
    echo ""
    printf "{{BOLD}}🎨 FRONTEND (no HOST - bun/npm + Vite):{{RESET}}\n"
    printf "  {{CYAN}}%-18s{{RESET}} %s\n" "npm-install" "npm install no host"
    printf "  {{CYAN}}%-18s{{RESET}} %s\n" "npm-dev" "Vite dev server (libera porta antes)"
