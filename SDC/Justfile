# ============================================================================
# 🔧 MENU INTERATIVO
# ============================================================================

[group('00 📚 AJUDA')]
@menu:
    #!/usr/bin/env bash
    printf "{{BOLD}}{{CYAN}}  SDC - MENU INTERATIVO{{RESET}}\n"
    echo ""
    printf "  {{GREEN}}1){{RESET}} Desenvolvimento (dev)\n"
    printf "  {{GREEN}}2){{RESET}} Rebuild dev (dev-build)\n"
    printf "  {{CYAN}}3){{RESET}} Status (status)\n"
    printf "  {{CYAN}}4){{RESET}} URLs (urls)\n"
    printf "  {{WHITE}}5){{RESET}} Shell App (shell)\n"
    printf "  {{CYAN}}6){{RESET}} Logs (logs)\n"
    printf "  {{YELLOW}}7){{RESET}} Healthcheck (health)\n"
    printf "  {{RED}}8){{RESET}} Parar stack dev (dev-down)\n"
    printf "  {{BLUE}}0){{RESET}} Ajuda (help)\n"
    echo ""
    read -p "Escolha uma opção: " choice
    case "$choice" in
        1) just dev ;;
        2) just dev-build ;;
        3) just status ;;
        4) just urls ;;
        5) just shell ;;
        6) just logs ;;
        7) just health ;;
        8) just dev-down ;;
        0) just help ;;
        *) printf "{{RED}}Opção inválida{{RESET}}\n" ;;
    esac

