    printf "  {{BLUE}}%-18s{{RESET}} %s\n" "prod-scale N" "Scale workers (ex: just prod-scale 5)"
    echo ""
    printf "{{BOLD}}📊 MONITORAMENTO:{{RESET}}\n"
