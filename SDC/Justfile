# Limpar todos os dados do TDAP (CUIDADO!)
tdap-clean:
    @echo "⚠️  ATENÇÃO: Limpando TODOS os dados do TDAP!"
    @echo "Pressione Ctrl+C para cancelar..."
    sleep 3
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "TRUNCATE TABLE tdap_movimentacoes; TRUNCATE TABLE tdap_recebimento_itens; TRUNCATE TABLE tdap_recebimentos; TRUNCATE TABLE tdap_product_lotes; TRUNCATE TABLE tdap_product_compositions; TRUNCATE TABLE tdap_products;"
    @echo "✅ Dados do TDAP limpos!"

