# 🔄 Setup inicial completo
@setup:
    just build-all
    just up-all
    just db-migrate
    just cache-optimize
    echo ""
    printf "{{BOLD}}{{GREEN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{GREEN}}  ✓ SETUP COMPLETO FINALIZADO!{{RESET}}\n"
    printf "{{BOLD}}{{GREEN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    just urls

# 🔄 Reset completo (⚠️ APAGA DADOS!)
@reset:
    just clean-volumes
    just build-all
    just up-all
    just db-migrate
    just db-seed
    echo ""
    printf "{{BOLD}}{{GREEN}}✓ RESET COMPLETO FINALIZADO!{{RESET}}\n"
    echo ""
    just urls

# 🔄 Deploy completo produção
@deploy-prod:
    printf "{{BOLD}}{{CYAN}}→ DEPLOY PRODUÇÃO{{RESET}}\n"
    git pull origin main
    just prod-build
    {{compose_prod}} exec app php artisan migrate --force
    {{compose_prod}} exec app php artisan config:cache
    {{compose_prod}} exec app php artisan route:cache
    {{compose_prod}} exec app php artisan view:cache
    printf "{{BOLD}}{{GREEN}}✓ DEPLOY CONCLUÍDO!{{RESET}}\n"

