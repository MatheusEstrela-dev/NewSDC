# Executar migrations do módulo TDAP
migrate-tdap:
    @echo "📦 Executando migrations do TDAP..."
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo ""
    @echo "📋 Migrations incluídas:"
    @echo "  - 2025_01_26_000001_create_tdap_products_table.php"
    @echo "  - 2025_01_26_000002_create_tdap_product_lotes_table.php"
    @echo "  - 2025_01_26_000003_create_tdap_product_compositions_table.php"
    @echo "  - 2025_01_26_000004_create_tdap_recebimentos_table.php"
    @echo "  - 2025_01_26_000005_create_tdap_recebimento_itens_table.php"
    @echo "  - 2025_01_26_000006_create_tdap_movimentacoes_table.php"
    @echo ""
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000001_create_tdap_products_table.php --force
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000002_create_tdap_product_lotes_table.php --force
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000003_create_tdap_product_compositions_table.php --force
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000004_create_tdap_recebimentos_table.php --force
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000005_create_tdap_recebimento_itens_table.php --force
    {{_app}} php artisan migrate --path=database/migrations/2025_01_26_000006_create_tdap_movimentacoes_table.php --force
    @echo ""
    @echo "✅ Migrations do TDAP executadas com sucesso!"
    @echo ""
    @echo "💡 Próximos passos:"
    @echo "  1. Execute: just seed-tdap"
    @echo "  2. Acesse: http://localhost:8001/tdap"

# Reverter migrations do TDAP
rollback-tdap:
    @echo "⏮️  Revertendo migrations do TDAP..."
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000006_create_tdap_movimentacoes_table.php --force
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000005_create_tdap_recebimento_itens_table.php --force
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000004_create_tdap_recebimentos_table.php --force
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000003_create_tdap_product_compositions_table.php --force
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000002_create_tdap_product_lotes_table.php --force
    {{_app}} php artisan migrate:rollback --path=database/migrations/2025_01_26_000001_create_tdap_products_table.php --force
    @echo "✅ Migrations do TDAP revertidas!"

