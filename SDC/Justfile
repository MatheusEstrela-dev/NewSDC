# ============================================================================
# SDC - JUSTFILE COMPLETO (Docker + DB + Módulos)
# Cross-Platform: Windows / Linux / macOS
# ============================================================================
# Uso: just <comando> ou just --list
# ============================================================================
# Espelho funcional do Makefile — mesmos comandos, mesmas portas.
# ============================================================================

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
set shell := ["bash", "-uc"]

export DOCKER_BUILDKIT := "1"
export COMPOSE_DOCKER_CLI_BUILD := "1"

# ============================================================================
# CORES ANSI
# ============================================================================
GREEN  := '\033[32m'
YELLOW := '\033[33m'
BLUE   := '\033[34m'
RED    := '\033[31m'
CYAN   := '\033[36m'
WHITE  := '\033[37m'
BOLD   := '\033[1m'
RESET  := '\033[0m'

# Variáveis
compose := "docker compose -f docker/docker-compose.yml"
compose_prod := "docker compose -f docker/docker-compose.prod.yml"
app := compose + " exec app"
db := compose + " exec db"

# Receita padrão
@default: help

# ============================================================================
# 📚 HELP
# ============================================================================

# 📚 Mostra ajuda categorizada
@help:
    echo ""
    printf "{{BOLD}}{{CYAN}}╔════════════════════════════════════════════════════════════════════╗{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}║     SDC - Sistema de Defesa Civil - Justfile Orquestrador          ║{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}╚════════════════════════════════════════════════════════════════════╝{{RESET}}\n"
    echo ""
    printf "{{BOLD}}📦 BUILD & SETUP:{{RESET}}\n"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "build-all" "Build completo de toda stack"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "build-dev" "Build apenas desenvolvimento"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "build-prod" "Build apenas produção"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "build-clean" "Build limpo (sem cache)"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "bridge" "Cria a rede bridge sdc_network"
    echo ""
    printf "{{BOLD}}🚀 AMBIENTE COMPLETO (ONE-COMMAND):{{RESET}}\n"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "start" "Bridge + build all + sobe toda stack (sem Ollama)"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "up-all" "Sobe TODA stack"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "down-all" "Para TODA stack"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "restart-all" "Reinicia TODA stack"
