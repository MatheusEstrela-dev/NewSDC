compose := "docker compose -f docker/docker-compose.yml"
# .env.prod na raiz do SDC e o env GLOBAL (app + CI); nunca commitado
compose_jenkins := "docker compose -f docker/jenkins/docker-compose.jenkins.yml --env-file .env.prod"
# stack dev ativo (newsdc_dev_*): db-backup/db-restore usam este, nao o
# {{compose}} generico acima (docker-compose.yml aponta pra containers
# newsdc_* sem "_dev_", que hoje nao estao no ar)
compose_dev := "docker compose -f docker/compose.dev.yml"
app := compose + " exec app"
db := compose_dev + " exec db"

