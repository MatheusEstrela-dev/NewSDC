    printf "  {{GREEN}}just prod-stack-app ab12cd3-b42{{RESET}}  # deploy inicial na VM\n"
    echo ""

# ============================================================================
# 🔧 DESENVOLVIMENTO (docker/compose.dev.yml - newsdc_dev_*)
# ============================================================================

# 🔧 Sobe a stack dev completa (app + db + redis + queue + mailhog)
@dev:
    printf "{{YELLOW}}→ Iniciando ambiente de desenvolvimento...{{RESET}}\n"
    {{compose}} up -d
    printf "{{GREEN}}✓ Ambiente de desenvolvimento iniciado!{{RESET}}\n"
    echo ""
    just urls

# 🔧 Desenvolvimento mínimo (apenas app + db + redis)
@dev-minimal:
    printf "{{YELLOW}}→ Iniciando ambiente mínimo...{{RESET}}\n"
    {{compose}} up -d app db redis
    printf "{{GREEN}}✓ Ambiente mínimo iniciado!{{RESET}}\n"

# 🔧 Rebuild das imagens + recria a stack dev
@dev-build:
    printf "{{YELLOW}}→ Rebuild e reinício do ambiente...{{RESET}}\n"
    {{compose}} down
    {{compose}} build
    {{compose}} up -d
    printf "{{GREEN}}✓ Rebuild concluído{{RESET}}\n"

# 🔧 Logs da stack dev (follow)
dev-logs:
    {{compose}} logs -f

# 🔧 Status dos containers dev
@dev-ps:
    {{compose}} ps

# 🔧 Para a stack dev (volumes preservados)
@dev-down:
    {{compose}} down
    printf "{{GREEN}}✓ Stack dev parada{{RESET}}\n"

# ============================================================================
# JENKINS CI/CD ON-PREMISE (docker/jenkins - VM 10.160.131.50)
# ============================================================================

# Build + sobe a infra de CI (Jenkins + socket-proxy + registry + backups)
@jenkins-build:
    {{compose_jenkins}} build
    {{compose_jenkins}} up -d

# Sobe a infra de CI sem rebuild
@jenkins-up:
    {{compose_jenkins}} up -d

# Logs do Jenkins master
jenkins-logs:
    {{compose_jenkins}} logs -f jenkins

# Para a infra de CI (volumes jenkins_home/registry preservados)
@jenkins-down:
    {{compose_jenkins}} down

# Setup completo de producao on-premise (uma vez por VM):
# valida o Swarm, exige o .env.prod global (raiz do SDC) e builda a infra de CI.
# As chaves de CI que o .env.prod precisa ter estao em docker/jenkins/.env.example.
# Proximos passos: rodar o job SDC/deploy-onprem (publica a 1a imagem),
# just prod-stack-data e just prod-stack-app.
@prod-setup:
    printf "{{BOLD}}{{CYAN}}-> PROD SETUP on-premise{{RESET}}\n"
    docker info | grep -qi "swarm: active" || { printf "{{RED}}Swarm inativo. Rode: docker swarm init --advertise-addr 10.160.131.50{{RESET}}\n"; exit 1; }
    test -f .env.prod || { printf "{{RED}}.env.prod nao encontrado na raiz do SDC. Crie a partir do seu .env do app + chaves de CI de docker/jenkins/.env.example{{RESET}}\n"; exit 1; }
    grep -q "^GITHUB_TOKEN=." .env.prod || printf "{{YELLOW}}Aviso: GITHUB_TOKEN vazio no .env.prod - o checkout do pipeline vai falhar{{RESET}}\n"
    grep -q "^JENKINS_ADMIN_PASSWORD=." .env.prod || printf "{{YELLOW}}Aviso: JENKINS_ADMIN_PASSWORD vazio no .env.prod{{RESET}}\n"
    just jenkins-build
    printf "{{GREEN}}Infra de CI no ar: Jenkins http://10.160.131.50:8080 | registry 127.0.0.1:5000{{RESET}}\n"

# Stack de DADOS (PostgreSQL + Redis) - isolada; o pipeline NUNCA a toca.
# Aplicar apenas em setup inicial ou mudanca deliberada (com backup Barman).
@prod-stack-data:
    docker network inspect sdc_internal >/dev/null 2>&1 || docker network create --driver overlay --attachable sdc_internal
    test -f /opt/sdc/.env.onprem || { printf "{{RED}}/opt/sdc/.env.onprem nao encontrado{{RESET}}\n"; exit 1; }
    sh -c 'set -a; . /opt/sdc/.env.onprem; set +a; docker stack deploy -c docker/jenkins/stack.data.onpremise.yml sdc-data'
    docker stack services sdc-data

# Stack de APLICACAO (app/queue/reverb/caddy) - deploy inicial ou topologia.
# Rolling update do dia a dia e do Jenkins (service update), nao daqui.
# Uso: just prod-stack-app ab12cd3-b42
@prod-stack-app version:
    docker network inspect sdc_internal >/dev/null 2>&1 || { printf "{{RED}}Rede sdc_internal ausente. Rode just prod-stack-data primeiro{{RESET}}\n"; exit 1; }
    test -f /opt/sdc/.env.onprem || { printf "{{RED}}/opt/sdc/.env.onprem nao encontrado{{RESET}}\n"; exit 1; }
    sh -c 'set -a; . /opt/sdc/.env.onprem; set +a; export VERSION={{version}}; docker stack deploy -c docker/jenkins/stack.app.onpremise.yml --with-registry-auth sdc'
    docker stack services sdc

# ============================================================================
# 💾 BANCO DE DADOS (Postgres da stack dev)
# ============================================================================

# 💾 Executar migrations
@db-migrate:
    {{app}} php artisan migrate --force

# 💾 Rollback migrations
@db-rollback:
    {{app}} php artisan migrate:rollback --force

# 💾 Fresh migrations + seed (APAGA DADOS!)
@db-fresh:
    printf "{{RED}}⚠️  Isso vai APAGAR todos os dados do banco dev!{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 3
    {{app}} php artisan migrate:fresh --seed --force

# 💾 Executar seeds
@db-seed:
    {{app}} php artisan db:seed --force

# 💾 Backup do banco (pg_dump -> storage/backups/)
@db-backup:
    printf "{{YELLOW}}→ Criando backup...{{RESET}}\n"
    mkdir -p storage/backups
    {{db}} pg_dump -U sdc -d sdc > storage/backups/backup-`date +%Y%m%d-%H%M%S`.sql
    printf "{{GREEN}}✓ Backup criado em storage/backups/{{RESET}}\n"

# 💾 Restore backup (uso: just db-restore arquivo.sql)
@db-restore file:
    printf "{{YELLOW}}→ Restaurando backup: {{file}}{{RESET}}\n"
    {{compose}} exec -T db psql -U sdc -d sdc < {{file}}
    printf "{{GREEN}}✓ Backup restaurado{{RESET}}\n"

# ============================================================================
# ⚙️ LARAVEL ARTISAN (dentro do container app)
# ============================================================================

# ⚙️ Limpa todos os caches
@cache-clear:
    printf "{{YELLOW}}→ Limpando caches...{{RESET}}\n"
    {{app}} php artisan cache:clear
    {{app}} php artisan config:clear
    {{app}} php artisan route:clear
    {{app}} php artisan view:clear
    printf "{{GREEN}}✓ Caches limpos{{RESET}}\n"

# ⚙️ Reconstroi caches (config/route/view/event)
@cache-optimize:
    printf "{{YELLOW}}→ Otimizando caches...{{RESET}}\n"
    {{app}} php artisan config:cache
    {{app}} php artisan route:cache
    {{app}} php artisan view:cache
    {{app}} php artisan event:cache
    printf "{{GREEN}}✓ Caches otimizados{{RESET}}\n"

# ⚙️ Executar artisan (uso: just artisan migrate)
@artisan +cmd:
    {{app}} php artisan {{cmd}}

# ============================================================================
# 🧪 TESTES
# ============================================================================

# 🧪 Executar testes unitarios (PHPUnit)
@test:
    {{app}} php artisan test

# 🧪 Testes com coverage
@test-coverage:
    {{app}} php artisan test --coverage

# 🧪 Testes filtrados (uso: just test-filter NomeDoTeste)
@test-filter filter:
    {{app}} php artisan test --filter={{filter}}

# 🧪 E2E - Testes Playwright (dotenvx injeta vault em runtime)
@test-e2e:
    printf "{{YELLOW}}-> Executando testes E2E (Playwright + dotenvx vault)...{{RESET}}\n"
    npx dotenvx run -f .env -f tests/e2e/.env.test -- npx playwright test
    printf "{{GREEN}}✓ Testes E2E concluidos{{RESET}}\n"

# 🧪 E2E - Apenas CRUD de Decretacoes
@test-e2e-crud:
    npx dotenvx run -f .env -f tests/e2e/.env.test -- npx playwright test tests/e2e/decretacoes-crud.spec.js

# 🧪 E2E - Modo UI interativo do Playwright
@test-e2e-ui:
    npx dotenvx run -f .env -f tests/e2e/.env.test -- npx playwright test --ui

# ============================================================================
# 🎨 FRONTEND (no HOST: o dev stack nao tem container node; Vite roda local)
# ============================================================================

# 🎨 Install dependências npm (host)
@npm-install:
    npm install --legacy-peer-deps

# 🎨 Vite dev server (host; libera a porta antes via scripts/ensure-vite-port-free)
npm-dev:
    npm run dev

# 🎨 Build de produção dos assets (host; prebuild regenera ziggy)
@npm-build:
    npm run build

# 🎨 Limpar cache do Vite e node_modules parciais
@npm-clean:
    rm -rf node_modules/.vite
    npm cache clean --force

# ============================================================================
# 🐚 ACESSO & DEBUG (stack dev)
# ============================================================================

# 🐚 Shell no container app
shell:
    {{compose}} exec app sh

# 🐚 Shell no app como root
shell-root:
    {{compose}} exec -u root app sh

# 🐚 psql no Postgres dev
shell-db:
    {{compose}} exec db psql -U sdc -d sdc

# 🐚 redis-cli no Redis dev
shell-redis:
    {{compose}} exec redis redis-cli

# 🐚 Shell no container queue
shell-queue:
    {{compose}} exec queue sh

# ============================================================================
# 📊 MONITORAMENTO (stack local LEGADA - docker/docker-compose.yml)
# Unica secao que ainda usa o compose legado; migrar junto com a Fase 2.
# ============================================================================

# 📊 Sobe Prometheus/Grafana locais (rede sdc_network legada)
@monitor:
    docker network inspect sdc_network > /dev/null 2>&1 || docker network create --driver bridge --subnet 172.26.0.0/16 sdc_network
    {{compose_legacy}} up -d prometheus grafana alertmanager node-exporter cadvisor redis-exporter blackbox-exporter
    printf "{{GREEN}}✓ Monitoramento local no ar{{RESET}}\n"
    printf "  Grafana:      {{GREEN}}http://localhost:13000{{RESET}}\n"
    printf "  Prometheus:   {{GREEN}}http://localhost:19090{{RESET}}\n"
    printf "  Alertmanager: {{GREEN}}http://localhost:19093{{RESET}}\n"

# 📊 Para monitoramento
@monitor-down:
    {{compose_legacy}} stop prometheus grafana alertmanager node-exporter cadvisor redis-exporter blackbox-exporter
    printf "{{GREEN}}✓ Monitoramento parado{{RESET}}\n"

# 📊 Logs do monitoramento
monitor-logs:
    {{compose_legacy}} logs -f prometheus grafana alertmanager

# ============================================================================
# 🗑️ LIMPEZA & MANUTENÇÃO
# ============================================================================

# 🗑️ Para e remove containers dev (preserva volumes)
@clean:
    printf "{{YELLOW}}→ Limpando containers dev...{{RESET}}\n"
    {{compose}} down
    printf "{{GREEN}}✓ Containers removidos{{RESET}}\n"

# 🗑️ Remove containers E volumes dev (⚠️ APAGA DADOS!)
@clean-volumes:
    printf "{{RED}}{{BOLD}}⚠️  ATENÇÃO: Isso vai APAGAR os dados do banco dev!{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 3
    {{compose}} down -v
    printf "{{GREEN}}✓ Containers e volumes removidos{{RESET}}\n"

# 🗑️ docker system prune GLOBAL do host
# PERIGO: atinge TODO o Docker da maquina - na VM isso inclui Jenkins,
# registry e stacks de PRODUCAO. NUNCA rodar na VM 10.160.131.50.
@clean-system:
    printf "{{RED}}{{BOLD}}⚠️  PERIGO: prune GLOBAL do Docker (host inteiro, nao so o SDC)!{{RESET}}\n"
    printf "{{RED}}   Na VM de producao isso destroi Jenkins/registry/stacks.{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 5
    docker system prune -af --volumes
    printf "{{GREEN}}✓ Sistema limpo{{RESET}}\n"

# ============================================================================
# 📋 STATUS & INFO
# ============================================================================

# 📋 Status completo dos containers
@status:
    printf "{{BOLD}}{{CYAN}}  STATUS DA STACK DEV{{RESET}}\n"
    {{compose}} ps
    echo ""
    printf "{{BOLD}}{{CYAN}}Containers ativos (newsdc*/sdc_*):{{RESET}}\n"
    docker ps --filter "name=newsdc" --filter "name=sdc_" --format "table {{{{.Names}}\t{{{{.Status}}\t{{{{.Ports}}"

# 📋 Alias para status
ps: status

# 📋 URLs e portas do ambiente dev
@urls:
    printf "{{BOLD}}{{CYAN}}  URLS E PORTAS (stack dev){{RESET}}\n"
    echo ""
    printf "{{BOLD}}🚀 APLICAÇÃO:{{RESET}}\n"
    printf "  App (Octane):      {{GREEN}}http://localhost:8000{{RESET}}\n"
    printf "  Health:            {{GREEN}}http://localhost:8000/health{{RESET}}\n"
    printf "  Vite (HMR, host):  {{GREEN}}http://localhost:5173{{RESET}}\n"
    echo ""
    printf "{{BOLD}}💾 DADOS:{{RESET}}\n"
    printf "  PostgreSQL:        {{GREEN}}localhost:5433{{RESET}} (user: sdc / db: sdc)\n"
    printf "  Redis:             {{GREEN}}localhost:6380{{RESET}}\n"
    echo ""
    printf "{{BOLD}}📧 FERRAMENTAS:{{RESET}}\n"
    printf "  Mailhog UI:        {{GREEN}}http://localhost:8025{{RESET}} (SMTP: 1025)\n"

# 📋 Logs de todos containers (follow)
logs:
    {{compose}} logs -f

# 📋 Logs apenas app
logs-app:
    {{compose}} logs -f app

# 📋 Logs apenas database
logs-db:
    {{compose}} logs -f db

# 📋 Logs queue worker
logs-queue:
    {{compose}} logs -f queue

# 🏥 Healthcheck dos serviços dev
@health:
    printf "{{BOLD}}{{CYAN}}Verificando saúde dos serviços...{{RESET}}\n"
    printf "{{YELLOW}}App /health: {{RESET}}"
    curl -sf http://localhost:8000/health > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Mailhog:     {{RESET}}"
    curl -sf http://localhost:8025 > /dev/null && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Postgres:    {{RESET}}"
    {{compose}} exec db pg_isready -U sdc -d sdc > /dev/null 2>&1 && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"
    printf "{{YELLOW}}Redis:       {{RESET}}"
    {{compose}} exec redis redis-cli ping > /dev/null 2>&1 && printf "{{GREEN}}✓ OK{{RESET}}\n" || printf "{{RED}}✗ FALHOU{{RESET}}\n"

# 📝 Informações do ambiente
@info:
    printf "{{BOLD}}Docker:{{RESET}}\n"
    docker version -f "  Versão:            {{{{.Server.Version}}"
    printf "{{BOLD}}Docker Compose:{{RESET}}\n"
    docker compose version --short | xargs -I {} echo "  Versão:            {}"
    printf "{{BOLD}}Just:{{RESET}}\n"
    just --version | xargs -I {} echo "  Versão:            {}"
    echo ""
    printf "{{BOLD}}Uso de recursos:{{RESET}}\n"
    docker system df

# ============================================================================
# 🔄 WORKFLOWS COMPLETOS
# ============================================================================

# 🔄 Setup inicial completo da stack dev
@setup:
    {{compose}} build
    just dev
    just db-migrate
    just cache-optimize
    printf "{{BOLD}}{{GREEN}}  ✓ SETUP COMPLETO FINALIZADO!{{RESET}}\n"

# 🔄 Reset completo da stack dev (⚠️ APAGA DADOS!)
@reset:
    just clean-volumes
    {{compose}} build
    just dev
    just db-migrate
    just db-seed
    printf "{{BOLD}}{{GREEN}}✓ RESET COMPLETO FINALIZADO!{{RESET}}\n"

# 📱 Inicia NativePHP Jump Server (QR Code para conectar celular)
@mobile-dev:
    ./scripts/start-mobile.sh

# ============================================================================
# 🔧 MENU INTERATIVO
# ============================================================================

@menu:
    #!/usr/bin/env bash
    printf "{{BOLD}}{{CYAN}}  SDC - MENU INTERATIVO{{RESET}}\n"
    echo ""
    printf "  {{GREEN}}1){{RESET}} Desenvolvimento (dev)\n"
    printf "  {{GREEN}}2){{RESET}} Rebuild dev (dev-build)\n"
    printf "  {{CYAN}}3){{RESET}} Status (status)\n"
    printf "  {{CYAN}}4){{RESET}} URLs (urls)\n"
    printf "  {{WHITE}}5){{RESET}} Shell App (shell)\n"
    printf "  {{CYAN}}6){{RESET}} Logs (logs)\n"
    printf "  {{YELLOW}}7){{RESET}} Healthcheck (health)\n"
    printf "  {{RED}}8){{RESET}} Parar stack dev (dev-down)\n"
    printf "  {{BLUE}}0){{RESET}} Ajuda (help)\n"
    echo ""
    read -p "Escolha uma opção: " choice
    case "$choice" in
        1) just dev ;;
        2) just dev-build ;;
        3) just status ;;
        4) just urls ;;
        5) just shell ;;
        6) just logs ;;
        7) just health ;;
        8) just dev-down ;;
        0) just help ;;
        *) printf "{{RED}}Opção inválida{{RESET}}\n" ;;
    esac

# ============================================================================
# FIM
# ============================================================================
