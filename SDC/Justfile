# 📋 Logs de todos containers (follow)
logs:
    {{compose}} logs -f

# 📋 Logs apenas app
logs-app:
    {{compose}} logs -f app

# 📋 Logs apenas nginx
logs-nginx:
    {{compose}} logs -f nginx

# 📋 Logs apenas database
logs-db:
    {{compose}} logs -f db

# 📋 Logs queue worker
logs-queue:
    {{compose}} logs -f queue

