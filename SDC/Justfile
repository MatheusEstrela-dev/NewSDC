# 📝 Informações do ambiente
@info:
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  INFORMAÇÕES DO AMBIENTE{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    printf "{{BOLD}}Host:{{RESET}}\n"
    printf "  UID:               {{GREEN}}`id -u`{{RESET}}\n"
    printf "  GID:               {{GREEN}}`id -g`{{RESET}}\n"
    printf "  Docker Buildkit:   {{GREEN}}$DOCKER_BUILDKIT{{RESET}}\n"
    echo ""
    printf "{{BOLD}}Docker:{{RESET}}\n"
    docker version -f "  Versão:            {{{{.Server.Version}}"
    echo ""
    printf "{{BOLD}}Docker Compose:{{RESET}}\n"
    docker compose version --short | xargs -I {} echo "  Versão:            {}"
    echo ""
    printf "{{BOLD}}Just:{{RESET}}\n"
    just --version | xargs -I {} echo "  Versão:            {}"
    echo ""
    printf "{{BOLD}}Uso de recursos:{{RESET}}\n"
    docker system df
    echo ""

# 📝 Versão das ferramentas
@version:
    printf "{{BOLD}}Versões instaladas:{{RESET}}\n"
    echo "Docker:          `docker --version`"
    echo "Docker Compose:  `docker compose version`"
    echo "Just:            `just --version`"

# ============================================================================
# 🔧 MENU INTERATIVO
# ============================================================================

@menu:
    #!/usr/bin/env bash
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  SDC - MENU INTERATIVO{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    printf "  {{GREEN}}1){{RESET}} Desenvolvimento (dev)\n"
    printf "  {{GREEN}}2){{RESET}} Desenvolvimento Completo (dev-full)\n"
    printf "  {{GREEN}}3){{RESET}} Build Completo (build-all)\n"
    printf "  {{CYAN}}4){{RESET}} Status (status)\n"
    printf "  {{CYAN}}5){{RESET}} URLs disponíveis (urls)\n"
    printf "  {{WHITE}}6){{RESET}} Shell App (shell)\n"
    printf "  {{CYAN}}7){{RESET}} Logs (logs)\n"
    printf "  {{YELLOW}}8){{RESET}} Healthcheck (health)\n"
    printf "  {{RED}}9){{RESET}} Parar tudo (down-all)\n"
    printf "  {{BLUE}}0){{RESET}} Ajuda (help)\n"
    echo ""
    read -p "Escolha uma opção: " choice
    case "$choice" in
        1) just dev ;;
        2) just dev-full ;;
        3) just build-all ;;
        4) just status ;;
        5) just urls ;;
        6) just shell ;;
        7) just logs ;;
        8) just health ;;
        9) just down-all ;;
        0) just help ;;
        *) printf "{{RED}}Opção inválida{{RESET}}\n" ;;
    esac

# ============================================================================
# FIM
# ============================================================================
 