# Listar produtos do TDAP
tdap-products:
    @echo "📦 Produtos Cadastrados no TDAP:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT id, codigo AS 'Código', nome AS 'Nome', tipo AS 'Tipo', grupo_risco AS 'Grupo Risco', estoque_minimo AS 'Est. Mín', estoque_maximo AS 'Est. Máx' FROM tdap_products ORDER BY tipo, codigo;"

# Listar tabelas do TDAP
tdap-tables:
    @echo "📋 Tabelas do Módulo TDAP:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SHOW TABLES LIKE 'tdap%';"

# Status completo do TDAP
tdap-status:
    @echo "📊 STATUS DO MÓDULO TDAP"
    @echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    @echo ""
    @echo "📦 Produtos:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT tipo AS 'Tipo', COUNT(*) AS 'Quantidade' FROM tdap_products GROUP BY tipo UNION ALL SELECT 'TOTAL', COUNT(*) FROM tdap_products;"
    @echo ""
    @echo "📦 Lotes:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT COUNT(*) AS 'Total Lotes', SUM(quantidade_atual) AS 'Quantidade Total' FROM tdap_product_lotes;" 2>/dev/null || echo "Nenhum lote cadastrado"
    @echo ""
    @echo "📥 Recebimentos:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT status AS 'Status', COUNT(*) AS 'Quantidade' FROM tdap_recebimentos GROUP BY status;" 2>/dev/null || echo "Nenhum recebimento cadastrado"
    @echo ""
    @echo "🔄 Movimentações:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT tipo AS 'Tipo', COUNT(*) AS 'Quantidade' FROM tdap_movimentacoes GROUP BY tipo;" 2>/dev/null || echo "Nenhuma movimentação registrada"

# Contar registros das tabelas do TDAP
tdap-count:
    @echo "🔢 Contagem de Registros do TDAP:"
    {{_db}} mysql -u root -p$$MYSQL_ROOT_PASSWORD $$MYSQL_DATABASE -e "SELECT 'Produtos' AS Tabela, COUNT(*) AS Registros FROM tdap_products UNION ALL SELECT 'Lotes', COUNT(*) FROM tdap_product_lotes UNION ALL SELECT 'Composições', COUNT(*) FROM tdap_product_compositions UNION ALL SELECT 'Recebimentos', COUNT(*) FROM tdap_recebimentos UNION ALL SELECT 'Itens Recebimento', COUNT(*) FROM tdap_recebimento_itens UNION ALL SELECT 'Movimentações', COUNT(*) FROM tdap_movimentacoes;"

