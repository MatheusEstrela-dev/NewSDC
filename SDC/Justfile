    printf "  {{GREEN}}just build-all{{RESET}}             # Build completo de toda stack\n"
    printf "  {{GREEN}}just up-all{{RESET}}                # Sobe ambiente completo (dev + monitoring)\n"
    printf "  {{GREEN}}just dev-full{{RESET}}              # Desenvolvimento com todas ferramentas\n"
    printf "  {{BLUE}}just prod{{RESET}}                  # Ambiente de produção\n"
