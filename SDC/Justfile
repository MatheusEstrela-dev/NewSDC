# ============================================================================
# 🌐 NETWORK & BRIDGE
# ============================================================================

# 📦 Cria a rede bridge sdc_network (para os ~15 containers, sem Ollama)
@bridge:
    printf "{{YELLOW}}→ Iniciando bridge (sdc_network)...{{RESET}}\n"
    docker network inspect sdc_network > /dev/null 2>&1 || \
        (printf "{{YELLOW}}→ Criando network bridge...{{RESET}}\n" && \
         docker network create --driver bridge --subnet 172.26.0.0/16 sdc_network)
    printf "{{GREEN}}✓ Bridge sdc_network OK{{RESET}}\n"

# 🌐 Alias: inicializa network (chama bridge)
@network-init: bridge

# 🌐 Inspeciona network
@network-inspect:
    docker network inspect sdc_network

# 🌐 Remove network
@network-clean:
    docker network rm sdc_network 2>/dev/null || true

# ============================================================================
# 🚀 COMANDOS ONE-COMMAND (BUILD & UP COMPLETO)
# ============================================================================

# 🚀 Build completo de TODA a stack (dev + monitoring + tools)
@build-all:
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  BUILD COMPLETO DE TODA A STACK{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    printf "{{YELLOW}}→ Construindo imagens de desenvolvimento...{{RESET}}\n"
    {{compose}} build --parallel
    printf "{{GREEN}}✓ Build de desenvolvimento concluído{{RESET}}\n"
    echo ""
    printf "{{BOLD}}{{GREEN}}✓ BUILD COMPLETO FINALIZADO COM SUCESSO!{{RESET}}\n"

# 📦 Build apenas desenvolvimento
@build-dev:
    printf "{{YELLOW}}→ Build de desenvolvimento...{{RESET}}\n"
    {{compose}} build --parallel
    printf "{{GREEN}}✓ Build concluído{{RESET}}\n"

# 📦 Build apenas produção
@build-prod:
    printf "{{YELLOW}}→ Build de produção...{{RESET}}\n"
    {{compose_prod}} build --parallel
    printf "{{GREEN}}✓ Build concluído{{RESET}}\n"

# 📦 Build limpo (sem cache)
@build-clean:
    printf "{{YELLOW}}→ Build limpo (sem cache)...{{RESET}}\n"
    {{compose}} build --no-cache --parallel
    printf "{{GREEN}}✓ Build limpo concluído{{RESET}}\n"

# 🚀 Sobe TODA stack (app + db + redis + monitoring + tools)
@up-all: network-init
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  SUBINDO STACK COMPLETA{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    printf "{{YELLOW}}→ Iniciando todos os serviços...{{RESET}}\n"
    {{compose}} --profile tools --profile ollama up -d
    echo ""
    printf "{{GREEN}}✓ Stack completa iniciada!{{RESET}}\n"
    echo ""
    just urls

# 🚀 Para TODA stack
@down-all:
    printf "{{YELLOW}}→ Parando todos os serviços...{{RESET}}\n"
    {{compose}} --profile tools --profile ollama down
    printf "{{GREEN}}✓ Todos os serviços parados{{RESET}}\n"

# 🚀 Reinicia TODA stack
@restart-all:
    printf "{{YELLOW}}→ Reiniciando stack completa...{{RESET}}\n"
    just down-all
    just up-all

# 🚀 Bridge + build all + sobe toda stack (COM Ollama)
@start: bridge
    just build-all
    just up-all
    echo ""
    printf "{{BOLD}}{{GREEN}}✓ Stack iniciada (bridge + build + up). Ollama incluído.{{RESET}}\n"
    just urls

# ============================================================================
# 🔧 DESENVOLVIMENTO
# ============================================================================

# 🔧 Ambiente de desenvolvimento padrão
@dev: network-init
    printf "{{YELLOW}}→ Iniciando ambiente de desenvolvimento...{{RESET}}\n"
    {{compose}} up -d app nginx db redis mailhog queue node
    printf "{{GREEN}}✓ Ambiente de desenvolvimento iniciado!{{RESET}}\n"
    echo ""
    printf "{{CYAN}}Serviços disponíveis:{{RESET}}\n"
    printf "  App (Laravel):     {{GREEN}}http://localhost:18001{{RESET}}\n"
    printf "  Nginx:             {{GREEN}}http://localhost:18082{{RESET}}\n"
    printf "  Vite (HMR):        {{GREEN}}http://localhost:15175{{RESET}}\n"
    printf "  Mailhog:           {{GREEN}}http://localhost:18026{{RESET}}\n"
    printf "  MySQL:             {{GREEN}}localhost:13307{{RESET}}\n"
    printf "  Redis:             {{GREEN}}localhost:16380{{RESET}}\n"

# 🔧 Desenvolvimento + ferramentas (phpmyadmin, redis-commander)
@dev-full: network-init
    printf "{{YELLOW}}→ Iniciando ambiente completo...{{RESET}}\n"
    {{compose}} --profile tools up -d
    printf "{{GREEN}}✓ Ambiente completo iniciado!{{RESET}}\n"
    echo ""
    just urls

# 🔧 Desenvolvimento mínimo (apenas app + db + redis)
@dev-minimal: network-init
    printf "{{YELLOW}}→ Iniciando ambiente mínimo...{{RESET}}\n"
    {{compose}} up -d app db redis
    printf "{{GREEN}}✓ Ambiente mínimo iniciado!{{RESET}}\n"

# 🔧 Rebuild desenvolvimento
@dev-build:
    printf "{{YELLOW}}→ Rebuild e reinicio do ambiente...{{RESET}}\n"
    {{compose}} down
    {{compose}} build
    {{compose}} up -d
    printf "{{GREEN}}✓ Rebuild concluído{{RESET}}\n"

# 🔧 Logs desenvolvimento (follow)
dev-logs:
    {{compose}} logs -f

# 🔧 Status dos containers dev
@dev-ps:
    {{compose}} ps

# ============================================================================
# 🏭 PRODUÇÃO
# ============================================================================

# 🏭 Ambiente de produção completo
@prod:
    printf "{{YELLOW}}→ Iniciando ambiente de produção...{{RESET}}\n"
    {{compose_prod}} up -d
    printf "{{GREEN}}✓ Ambiente de produção iniciado!{{RESET}}\n"

# 🏭 Build e deploy produção
@prod-build:
    printf "{{YELLOW}}→ Build de produção...{{RESET}}\n"
    {{compose_prod}} build --no-cache
    {{compose_prod}} up -d
    printf "{{GREEN}}✓ Deploy de produção concluído{{RESET}}\n"

# 🏭 Logs produção
prod-logs:
    {{compose_prod}} logs -f

# 🏭 Para produção
@prod-down:
    {{compose_prod}} down

# 🏭 Scale workers (uso: just prod-scale 5)
@prod-scale n="3":
    {{compose_prod}} up -d --scale queue={{n}}

# ============================================================================
# 📊 MONITORAMENTO
# ============================================================================

# 📊 Sobe stack de monitoramento completa
@monitor: network-init
    printf "{{YELLOW}}→ Iniciando stack de monitoramento...{{RESET}}\n"
    {{compose}} up -d prometheus grafana alertmanager node-exporter cadvisor mysql-exporter redis-exporter nginx-exporter blackbox-exporter
    printf "{{GREEN}}✓ Stack de monitoramento iniciada!{{RESET}}\n"
    echo ""
    printf "{{CYAN}}Dashboards disponíveis:{{RESET}}\n"
    printf "  Grafana:           {{GREEN}}http://localhost:13000{{RESET}} (admin/admin@123)\n"
    printf "  Prometheus:        {{GREEN}}http://localhost:19090{{RESET}}\n"
    printf "  Alertmanager:      {{GREEN}}http://localhost:19093{{RESET}}\n"
    printf "  cAdvisor:          {{GREEN}}http://localhost:8085{{RESET}}\n"
    echo ""
    printf "  Node Exporter:     {{CYAN}}http://localhost:19100/metrics{{RESET}}\n"
    printf "  MySQL Exporter:    {{CYAN}}http://localhost:19104/metrics{{RESET}}\n"
    printf "  Redis Exporter:    {{CYAN}}http://localhost:19121/metrics{{RESET}}\n"
    printf "  Nginx Exporter:    {{CYAN}}http://localhost:19113/metrics{{RESET}}\n"

# 📊 Para monitoramento
@monitor-down:
    printf "{{YELLOW}}→ Parando stack de monitoramento...{{RESET}}\n"
    {{compose}} stop prometheus grafana alertmanager node-exporter cadvisor mysql-exporter redis-exporter nginx-exporter blackbox-exporter
    printf "{{GREEN}}✓ Monitoramento parado{{RESET}}\n"

# 📊 Logs do monitoramento
monitor-logs:
    {{compose}} logs -f prometheus grafana alertmanager

# 📊 Reinicia monitoramento
@monitor-restart:
    just monitor-down
    just monitor

# ============================================================================
# 🐚 ACESSO & DEBUG
# ============================================================================

# 🐚 Shell app (www-data)
shell:
    {{compose}} exec app bash

# 🐚 Shell app (root)
shell-root:
    {{compose}} exec -u root app bash

# 🐚 MySQL CLI
shell-db:
    {{compose}} exec db mysql -u root -proot sdc

# 🐚 Redis CLI
shell-redis:
    {{compose}} exec redis redis-cli

# 🐚 Shell queue worker
shell-queue:
    {{compose}} exec queue bash

# 🐚 Shell node container
shell-node:
    {{compose}} exec node sh

# ============================================================================
# 🗑️ LIMPEZA & MANUTENÇÃO
# ============================================================================

# 🗑️ Para e remove containers (preserva volumes)
@clean:
    printf "{{YELLOW}}→ Limpando containers...{{RESET}}\n"
    {{compose}} down
    printf "{{GREEN}}✓ Containers removidos{{RESET}}\n"

# 🗑️ Remove containers E volumes (⚠️ APAGA DADOS!)
@clean-volumes:
    printf "{{RED}}{{BOLD}}⚠️  ATENÇÃO: Isso vai APAGAR todos os dados do banco!{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 3
    {{compose}} down -v
    printf "{{GREEN}}✓ Containers e volumes removidos{{RESET}}\n"

# 🗑️ Remove containers, volumes E imagens
@clean-images:
    printf "{{RED}}{{BOLD}}⚠️  ATENÇÃO: Isso vai remover TUDO!{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 5
    {{compose}} down -v --rmi all
    printf "{{GREEN}}✓ Tudo removido{{RESET}}\n"

# 🗑️ Limpeza completa do Docker system
@clean-system:
    printf "{{YELLOW}}→ Limpando sistema Docker...{{RESET}}\n"
    docker system prune -af --volumes
    printf "{{GREEN}}✓ Sistema limpo{{RESET}}\n"

# 🗑️ DESTRUIÇÃO TOTAL (⚠️ USA COM CUIDADO!)
@nuke:
    just clean-images
    just clean-system
    printf "{{RED}}{{BOLD}}💣 NUKE EXECUTADO!{{RESET}}\n"

# ============================================================================
# 💾 BANCO DE DADOS
# ============================================================================

# 💾 Executar migrations
@db-migrate:
    {{app}} php artisan migrate --force

# 💾 Rollback migrations
@db-rollback:
    {{app}} php artisan migrate:rollback --force

# 💾 Fresh migrations + seed
@db-fresh:
    printf "{{RED}}⚠️  Isso vai APAGAR todos os dados!{{RESET}}\n"
    printf "{{YELLOW}}Pressione Ctrl+C para cancelar...{{RESET}}\n"
    sleep 3
    {{app}} php artisan migrate:fresh --seed --force

# 💾 Executar seeds
@db-seed:
    {{app}} php artisan db:seed --force

# 💾 Backup do banco
@db-backup:
    printf "{{YELLOW}}→ Criando backup...{{RESET}}\n"
    mkdir -p storage/backups
    {{db}} mysqldump -u root -proot sdc > storage/backups/backup-`date +%Y%m%d-%H%M%S`.sql
    printf "{{GREEN}}✓ Backup criado em storage/backups/{{RESET}}\n"

# 💾 Restore backup (uso: just db-restore arquivo.sql)
@db-restore file:
    printf "{{YELLOW}}→ Restaurando backup: {{file}}{{RESET}}\n"
    {{compose}} exec -T db mysql -u root -proot sdc < {{file}}
    printf "{{GREEN}}✓ Backup restaurado{{RESET}}\n"

# ============================================================================
# 🎨 FRONTEND (Node.js + Vite)
# ============================================================================

# 🎨 Install dependências npm
@npm-install:
    {{compose}} exec node npm install --legacy-peer-deps

# 🎨 Update dependências npm
@npm-update:
    {{compose}} exec node npm update

# 🎨 Vite dev server
npm-dev:
    {{compose}} exec node npm run dev

# 🎨 Build produção
@npm-build:
    {{compose}} exec node npm run build

# 🎨 Build produção usando npx vite build
@npm-build-vite:
    {{compose}} exec node npx vite build

# 🎨 Limpar node_modules e cache
@npm-clean:
    {{compose}} exec node sh -c "rm -rf node_modules/.vite && npm cache clean --force"

# ============================================================================
# ⚙️ LARAVEL ARTISAN
# ============================================================================

# ⚙️ Limpa todos os caches
@cache-clear:
    printf "{{YELLOW}}→ Limpando caches...{{RESET}}\n"
    {{app}} php artisan cache:clear
    {{app}} php artisan config:clear
    {{app}} php artisan route:clear
    {{app}} php artisan view:clear
    printf "{{GREEN}}✓ Caches limpos{{RESET}}\n"

# ⚙️ Otimiza caches (produção)
@cache-optimize:
    printf "{{YELLOW}}→ Otimizando caches...{{RESET}}\n"
    {{app}} php artisan config:cache
    {{app}} php artisan route:cache
    {{app}} php artisan view:cache
    {{app}} php artisan event:cache
    printf "{{GREEN}}✓ Caches otimizados{{RESET}}\n"

# ⚙️ Executar artisan (uso: just artisan migrate)
@artisan +cmd:
    {{app}} php artisan {{cmd}}

# ============================================================================
# 📱 MOBILE DEV (NativePHP)
# ============================================================================

# 📱 Inicia NativePHP Jump Server (QR Code para conectar celular)
@mobile-dev:
    ./scripts/start-mobile.sh

# ============================================================================
# 📋 STATUS & INFO
# ============================================================================

# 📋 Status completo de todos containers
@status:
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  STATUS COMPLETO DA STACK{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
    {{compose}} ps
    echo ""
    printf "{{BOLD}}{{CYAN}}Containers ativos:{{RESET}}\n"
    docker ps --filter "name=newsdc" --format "table {{{{.Names}}\t{{{{.Status}}\t{{{{.Ports}}"

# 📋 Alias para status
ps: status

# 📋 Mostra todas URLs disponíveis
@urls:
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}  URLS E PORTAS DISPONÍVEIS{{RESET}}\n"
    printf "{{BOLD}}{{CYAN}}════════════════════════════════════════════════════════════{{RESET}}\n"
    echo ""
