    printf "{{BOLD}}{{CYAN}}╚════════════════════════════════════════════════════════════════════╝{{RESET}}\n"
    echo ""
    printf "{{BOLD}}🔧 DESENVOLVIMENTO (docker/compose.dev.yml - newsdc_dev_*):{{RESET}}\n"
    printf "  {{GREEN}}%-18s{{RESET}} %s\n" "dev" "Sobe a stack dev completa (app+db+redis+queue+mailhog)"
