# ============================================================================
# SDC - JUSTFILE COMPLETO (Docker + DB + Módulos)
# Cross-Platform: Windows / Linux / macOS
# ============================================================================
# Uso: just <comando> ou just --list

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
set shell := ["bash", "-uc"]

export DOCKER_BUILDKIT := "1"
export COMPOSE_DOCKER_CLI_BUILD := "1"

# Variáveis
compose := "docker compose -f docker/docker-compose.yml"
compose_prod := "docker compose -f docker/docker-compose.prod.yml"
app := compose + " exec app"
db := compose + " exec db"

# Receita padrão
@default: help

# ============================================================================
# 📚 HELP
# ============================================================================

# 📚 Mostra ajuda categorizada
@help:
    echo ""
    echo "╔════════════════════════════════════════════════════════════════════╗"
    echo "║     SDC - Sistema de Defesa Civil - Just Command Runner           ║"
    echo "╚════════════════════════════════════════════════════════════════════╝"
    echo ""
    echo "📦 BUILD & SETUP:"
    echo "  build-all       Build completo de toda stack"
    echo "  build-dev       Build apenas desenvolvimento"
    echo "  build-prod      Build apenas produção"
    echo "  build-clean     Build limpo (sem cache)"
    echo ""
    echo "🚀 AMBIENTE COMPLETO:"
    echo "  up-all          Sobe TODA stack"
    echo "  down-all        Para TODA stack"
    echo "  restart-all     Reinicia TODA stack"
    echo ""
    echo "🔧 DESENVOLVIMENTO:"
    echo "  dev             Ambiente de desenvolvimento"
    echo "  dev-full        Dev + ferramentas (phpmyadmin)"
    echo "  dev-minimal     Apenas app + db + redis"
    echo "  dev-build       Rebuild desenvolvimento"
    echo "  dev-logs        Logs (follow)"
    echo ""
    echo "🏭 PRODUÇÃO:"
    echo "  prod            Ambiente de produção"
    echo "  prod-build      Build e deploy produção"
    echo "  prod-logs       Logs produção"
    echo "  prod-down       Para produção"
    echo ""
    echo "📊 MONITORAMENTO:"
    echo "  monitor         Sobe monitoramento"
    echo "  monitor-down    Para monitoramento"
    echo ""
    echo "🐚 ACESSO:"
    echo "  shell           Shell app (www-data)"
    echo "  shell-root      Shell app (root)"
    echo "  shell-db        MySQL CLI"
    echo "  shell-redis     Redis CLI"
    echo ""
    echo "🗑️ LIMPEZA:"
    echo "  clean           Para containers"
    echo "  clean-volumes   Remove volumes (APAGA DADOS!)"
    echo "  clean-images    Remove tudo"
    echo "  nuke            DESTRUIÇÃO TOTAL"
    echo ""
    echo "💾 BANCO DE DADOS:"
    echo "  db-migrate      Executar migrations"
    echo "  db-rollback     Rollback migrations"
    echo "  db-fresh        Fresh + seed"
    echo "  db-seed         Executar seeds"
    echo "  db-backup       Backup do banco"
    echo ""
    echo "🎨 FRONTEND:"
    echo "  npm-install     Install npm"
    echo "  npm-dev         Vite dev server"
    echo "  npm-build       Build produção"
    echo ""
    echo "⚙️ ARTISAN:"
    echo "  cache-clear     Limpa caches"
    echo "  cache-optimize  Otimiza caches"
    echo "  artisan CMD     Executar artisan"
    echo ""
    echo "🧪 TESTES:"
    echo "  test            Executar testes"
    echo "  test-coverage   Testes com coverage"
    echo ""
    echo "📋 STATUS:"
    echo "  status          Status dos containers"
    echo "  urls            URLs disponíveis"
    echo "  logs            Logs de todos"
    echo "  health          Healthcheck"
    echo "  info            Informações"
    echo ""
    echo "🔄 WORKFLOWS:"
    echo "  setup           Setup inicial completo"
    echo "  reset           Reset completo"
    echo "  deploy-prod     Deploy produção"
    echo ""

# ============================================================================
# 🌐 NETWORK
# ============================================================================

@network-init:
    echo "→ Verificando network..."
    docker network inspect sdc_network > /dev/null 2>&1 || docker network create --driver bridge --subnet 172.26.0.0/16 sdc_network
    echo "✓ Network OK"

@network-inspect:
    docker network inspect sdc_network

@network-clean:
    docker network rm sdc_network 2>/dev/null || true

# ============================================================================
# 🚀 BUILD & UP
# ============================================================================

@build-all:
    echo "════════════════════════════════════════════════════════════"
    echo "  BUILD COMPLETO DE TODA A STACK"
    echo "════════════════════════════════════════════════════════════"
    {{compose}} build --parallel
    echo "✓ BUILD COMPLETO FINALIZADO!"

@build-dev:
    echo "→ Build de desenvolvimento..."
    {{compose}} build --parallel
    echo "✓ Build concluído"

@build-prod:
    echo "→ Build de produção..."
    {{compose_prod}} build --parallel
    echo "✓ Build concluído"

@build-clean:
    echo "→ Build limpo (sem cache)..."
    {{compose}} build --no-cache --parallel
    echo "✓ Build limpo concluído"

@up-all: network-init
    echo "════════════════════════════════════════════════════════════"
    echo "  SUBINDO STACK COMPLETA"
    echo "════════════════════════════════════════════════════════════"
    {{compose}} --profile tools up -d
    echo "✓ Stack completa iniciada!"
    just urls

@down-all:
    echo "→ Parando todos os serviços..."
    {{compose}} --profile tools down
    echo "✓ Todos os serviços parados"

@restart-all:
    just down-all
    just up-all

# ============================================================================
# 🔧 DESENVOLVIMENTO
# ============================================================================

@dev: network-init
    echo "→ Iniciando ambiente de desenvolvimento..."
    {{compose}} up -d app nginx db redis mailhog queue node
    echo "✓ Ambiente de desenvolvimento iniciado!"
    echo ""
    echo "Serviços disponíveis:"
    echo "  App (Laravel):  http://localhost:8001"
    echo "  Nginx:          http://localhost:8082"
    echo "  Vite (HMR):     http://localhost:5173"
    echo "  Mailhog:        http://localhost:8026"
    echo "  MySQL:          localhost:3307"
    echo "  Redis:          localhost:6380"

@dev-full: network-init
    echo "→ Iniciando ambiente completo..."
    {{compose}} --profile tools up -d
    echo "✓ Ambiente completo iniciado!"
    just urls

@dev-minimal: network-init
    echo "→ Iniciando ambiente mínimo..."
    {{compose}} up -d app db redis
    echo "✓ Ambiente mínimo iniciado!"

@dev-build:
    echo "→ Rebuild desenvolvimento..."
    {{compose}} down
    {{compose}} build
    {{compose}} up -d
    echo "✓ Rebuild concluído"

dev-logs:
    {{compose}} logs -f

@dev-ps:
    {{compose}} ps

# ============================================================================
# 🏭 PRODUÇÃO
# ============================================================================

@prod:
    echo "→ Iniciando produção..."
    {{compose_prod}} up -d
    echo "✓ Ambiente de produção iniciado!"

@prod-build:
    echo "→ Build de produção..."
    {{compose_prod}} build --no-cache
    {{compose_prod}} up -d
    echo "✓ Deploy de produção concluído"

prod-logs:
    {{compose_prod}} logs -f

@prod-down:
    {{compose_prod}} down

@prod-scale n="3":
    {{compose_prod}} up -d --scale queue={{n}}

# ============================================================================
# 📊 MONITORAMENTO
# ============================================================================

@monitor: network-init
    echo "→ Iniciando monitoramento..."
    {{compose}} up -d prometheus grafana alertmanager node-exporter cadvisor mysql-exporter redis-exporter nginx-exporter blackbox-exporter
    echo "✓ Monitoramento iniciado!"
    echo ""
    echo "Dashboards:"
    echo "  Grafana:      http://localhost:3000 (admin/admin@123)"
    echo "  Prometheus:   http://localhost:9090"
    echo "  Alertmanager: http://localhost:9093"
    echo "  cAdvisor:     http://localhost:8080"

@monitor-down:
    echo "→ Parando monitoramento..."
    {{compose}} stop prometheus grafana alertmanager node-exporter cadvisor mysql-exporter redis-exporter nginx-exporter blackbox-exporter
    echo "✓ Monitoramento parado"

monitor-logs:
    {{compose}} logs -f prometheus grafana alertmanager

@monitor-restart:
    just monitor-down
    just monitor

# ============================================================================
# 🐚 ACESSO & DEBUG
# ============================================================================

shell:
    {{compose}} exec app bash

shell-root:
    {{compose}} exec -u root app bash

shell-db:
    {{compose}} exec db mysql -u root -proot sdc

shell-redis:
    {{compose}} exec redis redis-cli

shell-queue:
    {{compose}} exec queue bash

shell-node:
    {{compose}} exec node sh

# ============================================================================
# 🗑️ LIMPEZA
# ============================================================================

@clean:
    echo "→ Limpando containers..."
    {{compose}} down
    echo "✓ Containers removidos"

@clean-volumes:
    echo "⚠️ ATENÇÃO: Isso vai APAGAR todos os dados!"
    sleep 3
    {{compose}} down -v
    echo "✓ Containers e volumes removidos"

@clean-images:
    echo "⚠️ ATENÇÃO: Isso vai remover TUDO!"
    sleep 5
    {{compose}} down -v --rmi all
    echo "✓ Tudo removido"

@clean-system:
    echo "→ Limpando sistema Docker..."
    docker system prune -af --volumes
    echo "✓ Sistema limpo"

@nuke:
    just clean-images
    just clean-system
    echo "💣 NUKE EXECUTADO!"

# ============================================================================
# 💾 BANCO DE DADOS
# ============================================================================

@db-migrate:
    {{app}} php artisan migrate --force

@db-rollback:
    {{app}} php artisan migrate:rollback --force

@db-fresh:
    echo "⚠️ Isso vai APAGAR todos os dados!"
    sleep 3
    {{app}} php artisan migrate:fresh --seed --force

@db-seed:
    {{app}} php artisan db:seed --force

@db-backup:
    echo "→ Criando backup..."
    mkdir -p storage/backups
    {{db}} mysqldump -u root -proot sdc > storage/backups/backup-`date +%Y%m%d-%H%M%S`.sql
    echo "✓ Backup criado em storage/backups/"

@db-restore file:
    echo "→ Restaurando backup: {{file}}"
    {{compose}} exec -T db mysql -u root -proot sdc < {{file}}
    echo "✓ Backup restaurado"

# ============================================================================
# 🎨 FRONTEND
# ============================================================================

@npm-install:
    {{compose}} exec node npm install --legacy-peer-deps

@npm-update:
    {{compose}} exec node npm update

npm-dev:
    {{compose}} exec node npm run dev

@npm-build:
    {{compose}} exec node npm run build

@npm-clean:
    {{compose}} exec node sh -c "rm -rf node_modules/.vite && npm cache clean --force"

# ============================================================================
# ⚙️ LARAVEL ARTISAN
# ============================================================================

@cache-clear:
    echo "→ Limpando caches..."
    {{app}} php artisan cache:clear
    {{app}} php artisan config:clear
    {{app}} php artisan route:clear
    {{app}} php artisan view:clear
    echo "✓ Caches limpos"

@cache-optimize:
    echo "→ Otimizando caches..."
    {{app}} php artisan config:cache
    {{app}} php artisan route:cache
    {{app}} php artisan view:cache
    {{app}} php artisan event:cache
    echo "✓ Caches otimizados"

@artisan +cmd:
    {{app}} php artisan {{cmd}}

# ============================================================================
# 📋 STATUS & INFO
# ============================================================================

@status:
    echo "════════════════════════════════════════════════════════════"
    echo "  STATUS COMPLETO DA STACK"
    echo "════════════════════════════════════════════════════════════"
    {{compose}} ps
    echo ""
    echo "Containers ativos:"
    docker ps --filter "name=newsdc" --format "table {{{{.Names}}}}\t{{{{.Status}}}}\t{{{{.Ports}}}}"

ps: status

@urls:
    echo "════════════════════════════════════════════════════════════"
    echo "  URLS E PORTAS DISPONÍVEIS"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "🚀 APLICAÇÃO:"
    echo "  App (Laravel):     http://localhost:8001"
    echo "  Nginx:             http://localhost:8082"
    echo "  Vite (HMR):        http://localhost:5173"
    echo ""
    echo "💾 BANCO DE DADOS:"
    echo "  MySQL:             localhost:3307 (user: sdc, pass: secret)"
    echo "  Redis:             localhost:6380"
    echo "  phpMyAdmin:        http://localhost:8083"
    echo "  Redis Commander:   http://localhost:8084"
    echo ""
    echo "📧 FERRAMENTAS:"
    echo "  Mailhog:           http://localhost:8026"
    echo ""
    echo "📊 MONITORAMENTO:"
    echo "  Grafana:           http://localhost:3000 (admin/admin@123)"
    echo "  Prometheus:        http://localhost:9090"
    echo "  Alertmanager:      http://localhost:9093"
    echo "  cAdvisor:          http://localhost:8080"

logs:
    {{compose}} logs -f

logs-app:
    {{compose}} logs -f app

logs-nginx:
    {{compose}} logs -f nginx

logs-db:
    {{compose}} logs -f db

logs-queue:
    {{compose}} logs -f queue

# ============================================================================
# 🧪 TESTES
# ============================================================================

@test:
    {{app}} php artisan test

@test-coverage:
    {{app}} php artisan test --coverage

@test-filter filter:
    {{app}} php artisan test --filter={{filter}}

# ============================================================================
# 🔄 WORKFLOWS COMPLETOS
# ============================================================================

@setup:
    just build-all
    just up-all
    just db-migrate
    just cache-optimize
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo "  ✓ SETUP COMPLETO FINALIZADO!"
    echo "════════════════════════════════════════════════════════════"
    just urls

@reset:
    just clean-volumes
    just build-all
    just up-all
    just db-migrate
    just db-seed
    echo "✓ RESET COMPLETO FINALIZADO!"
    just urls

@deploy-prod:
    echo "→ DEPLOY PRODUÇÃO"
    git pull origin main
    just prod-build
    {{compose_prod}} exec app php artisan migrate --force
    {{compose_prod}} exec app php artisan config:cache
    {{compose_prod}} exec app php artisan route:cache
    {{compose_prod}} exec app php artisan view:cache
    echo "✓ DEPLOY CONCLUÍDO!"

# ============================================================================
# 🏥 HEALTHCHECK
# ============================================================================

@health:
    echo "Verificando saúde dos serviços..."
    echo ""
    echo -n "App:         "
    curl -sf http://localhost:8001 > /dev/null && echo "✓ OK" || echo "✗ FALHOU"
    echo -n "Nginx:       "
    curl -sf http://localhost:8082 > /dev/null && echo "✓ OK" || echo "✗ FALHOU"
    echo -n "Vite:        "
    curl -sf http://localhost:5173 > /dev/null && echo "✓ OK" || echo "✗ FALHOU"
    echo -n "Grafana:     "
    curl -sf http://localhost:3000/api/health > /dev/null && echo "✓ OK" || echo "✗ FALHOU"
    echo -n "Prometheus:  "
    curl -sf http://localhost:9090/-/healthy > /dev/null && echo "✓ OK" || echo "✗ FALHOU"

# ============================================================================
# 📝 INFO
# ============================================================================

@info:
    echo "════════════════════════════════════════════════════════════"
    echo "  INFORMAÇÕES DO AMBIENTE"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "Docker:"
    docker version --format '  Versão: {{{{.Server.Version}}}}'
    echo ""
    echo "Docker Compose:"
    docker compose version
    echo ""
    echo "Just:"
    just --version
    echo ""
    echo "Uso de recursos:"
    docker system df

@version:
    echo "Versões instaladas:"
    echo "Docker:          `docker --version`"
    echo "Docker Compose:  `docker compose version`"
    echo "Just:            `just --version`"

# ============================================================================
# 🔧 MENU INTERATIVO
# ============================================================================

@menu:
    echo "════════════════════════════════════════════════════════════"
    echo "  SDC - MENU INTERATIVO"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "  1) Desenvolvimento (dev)"
    echo "  2) Desenvolvimento Completo (dev-full)"
    echo "  3) Build Completo (build-all)"
    echo "  4) Status (status)"
    echo "  5) URLs disponíveis (urls)"
    echo "  6) Shell App (shell)"
    echo "  7) Logs (logs)"
    echo "  8) Healthcheck (health)"
    echo "  9) Parar tudo (down-all)"
    echo "  0) Ajuda (help)"
    echo ""

@run choice:
    #!/usr/bin/env bash
    case "{{choice}}" in
        1) just dev ;;
        2) just dev-full ;;
        3) just build-all ;;
        4) just status ;;
        5) just urls ;;
        6) just shell ;;
        7) just logs ;;
        8) just health ;;
        9) just down-all ;;
        0) just help ;;
        *) echo "Opção inválida" ;;
    esac

# ============================================================================
# FIM
# ============================================================================
