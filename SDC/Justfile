    printf "{{BOLD}}💾 BANCO DE DADOS:{{RESET}}\n"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-migrate" "Executar migrations"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-rollback" "Rollback migrations"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-fresh" "Fresh + seed"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-seed" "Executar seeds"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-backup" "Backup do banco"
    printf "  {{YELLOW}}%-18s{{RESET}} %s\n" "db-restore FILE" "Restore backup"
