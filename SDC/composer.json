{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "azure-oss/storage-blob-flysystem": "^1.6",
        "darkaonline/l5-swagger": "^8.6",
        "doctrine/dbal": "^4",
        "doctrine/orm": "^3",
        "google-gemini-php/client": "*",
        "guzzlehttp/guzzle": "^7.9",
        "inertiajs/inertia-laravel": "^1.3",
        "laravel/breeze": "^2.2",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.13",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "nativephp/mobile": "^3.0",
        "predis/predis": "^3.4",
        "rap2hpoutre/laravel-log-viewer": "^2.5",
        "saloonphp/saloon": "^3.14",
        "spatie/laravel-medialibrary": "^11.10",
        "spatie/laravel-permission": "^6.24",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0",
        "theodo-group/llphant": "*",
        "tightenco/ziggy": "^2.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.1",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.37",
        "laravel/telescope": "^5.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^11.4",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Core\\": "core/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "app/Modules/Tdap/Requests/CronogramaRequest.php",
            "app/Modules/Tdap/Requests/PrestadoresRequest.php",
            "app/Modules/Pmda/Controllers/PmdaController.php",
            "app/Modules/Pmda/Services/PmdaService.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope",
                "nativephp/mobile"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.30"
        },
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
