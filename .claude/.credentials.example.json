{
    "ai_gemini": {
        "driver": "gemini",
        "api_key": "<gemini-api-key>",
        "model": "gemini-2.5-flash-lite",
        "max_tokens": 4096
    },
    "database_prod": {
        "connection": "pgsql",
        "host": "<postgres-host>",
        "port": 5432,
        "database": "<database-name>",
        "username": "<username>",
        "password": "<password>",
        "sslmode": "require"
    },
    "notion_prod": {
        "key": "<notion-integration-token>"
    },
    "redis_prod": {
        "host": "<redis-host>",
        "port": 6379,
        "password": "<redis-password>",
        "sslmode": "require"
    },
    "azure_prod": {
        "subscription_name": "<azure-subscription-name>",
        "subscription_id": "<subscription-id-guid>",
        "tenant_id": "<tenant-id-guid>",
        "tenant_domain": "<tenant.onmicrosoft.com>",
        "user": "<user-upn>",
        "sp_name": "<service-principal-name>",
        "client_id": "<sp-client-id-guid>",
        "client_secret": "<sp-client-secret>",
        "resource_group": "<resource-group>",
        "location": "brazilsouth",
        "storage_account": "<storage-account-name>",
        "storage_key": "<storage-account-key>",
        "storage_endpoint_blob": "https://<storage-account-name>.blob.core.windows.net/"
    },
    "smtp_prod": {
        "host": "<smtp-host>",
        "port": 587,
        "encryption": "tls",
        "username": "<smtp-username>",
        "password": "<smtp-password>",
        "from": "<from-address>"
    }
}
